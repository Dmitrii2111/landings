      ['complex','Сложные случаи','All-on-4 после многолетнего неудачного съёмного протезирования','Пациентка, 71 год. Выраженная двусторонняя атрофия — тилт-имплантация без костной пластики.','1 день'],
    ];

    var built = false;
    function buildCards() {
      if (built) return;
      built = true;
      CASES.forEach(function(c, i) {
        var bImg = '/images/dental/' + BI[i % 7];
        var aImg = '/images/dental/' + AI[(i + 4) % 7];
        var el = document.createElement('article');
        el.className = 'bg-white rounded-2xl overflow-hidden ring-inset-1';
        el.setAttribute('data-modal-category', c[0]);
        el.innerHTML =
          '<div class="ba aspect-[4/3] bg-soft" data-dental-ba>' +
            '<img src="'+bImg+'" alt="До" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async"/>' +
            '<div class="after"><img src="'+aImg+'" alt="После" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async"/></div>' +
            '<span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-white/90 text-[10px] font-bold uppercase tracking-wider pointer-events-none">До</span>' +
            '<span class="absolute top-2 right-2 px-2 py-0.5 rounded-md bg-ink text-white text-[10px] font-bold uppercase tracking-wider pointer-events-none">После</span>' +
            '<div class="handle" data-dental-ba-handle></div>' +
          '</div>' +
          '<div class="p-4">' +
            '<div class="flex items-center gap-2 text-xs">' +
              '<span class="px-2 py-0.5 rounded-md bg-soft text-muted">'+c[1]+'</span>' +
              '<span class="text-muted">·</span><span class="text-muted">'+c[4]+'</span>' +
            '</div>' +
            '<h3 class="font-semibold mt-2 text-sm leading-snug">'+c[2]+'</h3>' +
            '<p class="dental-modal-desc text-xs text-muted mt-1">'+c[3]+'</p>' +
          '</div>';
        grid.appendChild(el);
      });
      dentalInitBaSliders(grid);
    }

    function openModal() {
      buildCards();
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', function(e) { e.preventDefault(); openModal(); });
    if (closeBtn)  closeBtn.addEventListener('click', closeModal);
    if (backdrop)  backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });

    if (filtersEl) {
      filtersEl.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-modal-filter]');
        if (!btn) return;
        var filter = btn.getAttribute('data-modal-filter');
        filtersEl.querySelectorAll('[data-modal-filter]').forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var cards = grid.querySelectorAll('[data-modal-category]');
        var visible = 0;
        cards.forEach(function(card) {
          var match = filter === 'all' || card.getAttribute('data-modal-category') === filter;
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        if (emptyEl) emptyEl.style.display = visible === 0 ? '' : 'none';
      });
    }
  })();

  document.querySelectorAll('[data-dental-form]').forEach(function(form) {
    var btn = form.querySelector('[data-dental-submit]');
    if (!btn) return;
    btn.addEventListener('click', function() {
      dentalClearErrors(form);
      var valid = true;

      var nameEl = form.querySelector('[data-dental-name]');
      if (nameEl) {
        var name = nameEl.value.trim();
        if (name.length < 2) {
          dentalShowError(nameEl, 'Введите имя (минимум 2 символа)');
          valid = false;
        }
      }

      var phoneEl = form.querySelector('[data-dental-phone]');
      if (phoneEl) {
        if (!dentalValidatePhone(phoneEl.value)) {
          dentalShowError(phoneEl, 'Введите корректный российский номер телефона');
          valid = false;
        }
      }

      if (!valid) return;

      form.querySelectorAll('input, textarea').forEach(function(el) { el.value = ''; });
      dentalShowToast();
    });
  });
</script>

