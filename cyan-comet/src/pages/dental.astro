<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var current = document.documentElement.getAttribute('data-theme') || 'light';
    var next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });

  var pricingGrid = document.getElementById('dental-pricing-grid');
  if (pricingGrid) {
    pricingGrid.addEventListener('click', function(e) {
      var card = e.target.closest('[data-dental-price]');
      if (!card) return;
      pricingGrid.querySelectorAll('[data-dental-price]').forEach(function(c) {
        c.classList.remove('is-active');
      });
      card.classList.add('is-active');
    });
  }

  document.querySelectorAll('.dental-faq details summary').forEach(function(summary) {
    summary.addEventListener('click', function(e) {
      e.preventDefault();
      var det = summary.closest('details');
      var wasOpen = det.classList.contains('is-open');
      document.querySelectorAll('.dental-faq details').forEach(function(d) {
        d.classList.remove('is-open');
      });
      if (!wasOpen) det.classList.add('is-open');
    });
  });

  // ── Form validation ──
  function dentalValidatePhone(val) {
    var digits = val.replace(/\D/g, '');
    return digits.length === 11 && (digits[0] === '7' || digits[0] === '8');
  }

  function dentalShowError(input, msg) {
    input.classList.add('dental-input-error');
    var err = input.parentElement ? input.parentElement.querySelector('.dental-field-error') : null;
    if (err) err.textContent = msg;
  }

  function dentalClearErrors(form) {
    form.querySelectorAll('.dental-input-error').forEach(function(el) {
      el.classList.remove('dental-input-error');
    });
    form.querySelectorAll('.dental-field-error').forEach(function(el) {
      el.textContent = '';
    });
  }

  function dentalShowToast() {
    var toast = document.getElementById('dental-toast');
    if (!toast) return;
    toast.classList.add('is-visible');
    setTimeout(function() { toast.classList.remove('is-visible'); }, 4500);
  }

  // ── Cases filter ──
  (function() {
    var filtersEl = document.getElementById('dental-cases-filters');
    var gridEl    = document.getElementById('dental-cases-grid');
    var emptyEl   = document.getElementById('dental-cases-empty');
    if (!filtersEl || !gridEl) return;
    filtersEl.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-dental-filter]');
      if (!btn) return;
      var filter = btn.getAttribute('data-dental-filter');
      filtersEl.querySelectorAll('[data-dental-filter]').forEach(function(b) {
        b.classList.remove('is-active');
      });
      btn.classList.add('is-active');
      var articles = gridEl.querySelectorAll('[data-dental-category]');
      var visible = 0;
      articles.forEach(function(art) {
        var match = filter === 'all' || art.getAttribute('data-dental-category') === filter;
        art.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (emptyEl) emptyEl.style.display = visible === 0 ? '' : 'none';
    });
  })();

  // ── Before/After slider (shared tracker — single set of document listeners) ──
  var _dBaActive = null;
  document.addEventListener('mousemove', function(e) {
    if (_dBaActive) _dBaActive(e.clientX);
  });
  document.addEventListener('mouseup',   function() { _dBaActive = null; });
  document.addEventListener('touchmove', function(e) {
    if (_dBaActive) _dBaActive(e.touches[0].clientX);
  }, { passive: true });
  document.addEventListener('touchend',  function() { _dBaActive = null; }, { passive: true });

  function dentalInitBaSliders(root) {
    (root || document).querySelectorAll('[data-dental-ba]').forEach(function(ba) {
      if (ba._dBaInit) return;
      ba._dBaInit = true;
      var handle  = ba.querySelector('[data-dental-ba-handle]');
      var afterEl = ba.querySelector('.after');
      if (!handle || !afterEl) return;
      function setPos(pct) {
        pct = Math.max(5, Math.min(95, pct));
        handle.style.left = pct + '%';
        afterEl.style.clipPath = 'inset(0 0 0 ' + pct + '%)';
      }
      function pctFrom(clientX) {
        var r = ba.getBoundingClientRect();
        return ((clientX - r.left) / r.width) * 100;
      }
      setPos(50);
      handle.addEventListener('mousedown', function(e) { e.preventDefault(); _dBaActive = function(x) { setPos(pctFrom(x)); }; });
      handle.addEventListener('touchstart', function() { _dBaActive = function(x) { setPos(pctFrom(x)); }; }, { passive: true });
      ba.addEventListener('click', function(e) { if (e.target !== handle) setPos(pctFrom(e.clientX)); });
    });
  }
  dentalInitBaSliders();

  // ── Cases Modal ──
  (function() {
