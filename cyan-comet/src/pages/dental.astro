<script is:inline define:vars={{ __dm: dental.cases.modalCases, __dfm: dental.formMessages }}>
  window.__dentalModalCases = __dm;
  window.__dentalFormMessages = __dfm;
</script>

<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var current = document.documentElement.getAttribute('data-theme') || 'light';
    var next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });

  var pricingGrid = document.getElementById('dental-pricing-grid');
  if (pricingGrid) {
    pricingGrid.addEventListener('click', function(e) {
      var card = e.target.closest('[data-dental-price]');
      if (!card) return;
      pricingGrid.querySelectorAll('[data-dental-price]').forEach(function(c) {
        c.classList.remove('is-active');
      });
      card.classList.add('is-active');
    });
  }

  document.querySelectorAll('.dental-faq details summary').forEach(function(summary) {
    summary.addEventListener('click', function(e) {
      e.preventDefault();
      var det = summary.closest('details');
      var wasOpen = det.classList.contains('is-open');
      document.querySelectorAll('.dental-faq details').forEach(function(d) {
        d.classList.remove('is-open');
      });
      if (!wasOpen) det.classList.add('is-open');
    });
  });

  // ── Form validation ──
  function dentalValidatePhone(val) {
    var digits = val.replace(/\D/g, '');
    return digits.length === 11 && (digits[0] === '7' || digits[0] === '8');
  }

  function dentalShowError(input, msg) {
    input.classList.add('dental-input-error');
    var err = input.parentElement ? input.parentElement.querySelector('.dental-field-error') : null;
    if (err) err.textContent = msg;
  }

  function dentalClearErrors(form) {
    form.querySelectorAll('.dental-input-error').forEach(function(el) {
      el.classList.remove('dental-input-error');
    });
    form.querySelectorAll('.dental-field-error').forEach(function(el) {
      el.textContent = '';
    });
  }

  function dentalShowToast() {
    var toast = document.getElementById('dental-toast');
    if (!toast) return;
    toast.classList.add('is-visible');
    setTimeout(function() { toast.classList.remove('is-visible'); }, 4500);
  }

  // ── Cases filter ──
  (function() {
    var filtersEl = document.getElementById('dental-cases-filters');
    var gridEl    = document.getElementById('dental-cases-grid');
    var emptyEl   = document.getElementById('dental-cases-empty');
    if (!filtersEl || !gridEl) return;
    filtersEl.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-dental-filter]');
      if (!btn) return;
      var filter = btn.getAttribute('data-dental-filter');
      filtersEl.querySelectorAll('[data-dental-filter]').forEach(function(b) {
        b.classList.remove('is-active');
      });
      btn.classList.add('is-active');
      var articles = gridEl.querySelectorAll('[data-dental-category]');
      var visible = 0;
      articles.forEach(function(art) {
        var match = filter === 'all' || art.getAttribute('data-dental-category') === filter;
        art.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (emptyEl) emptyEl.style.display = visible === 0 ? '' : 'none';
    });
  })();

  // ── Before/After slider (shared tracker — single set of document listeners) ──
  var _dBaActive = null;
  document.addEventListener('mousemove', function(e) {
    if (_dBaActive) _dBaActive(e.clientX);
  });
  document.addEventListener('mouseup',   function() { _dBaActive = null; });
  document.addEventListener('touchmove', function(e) {
    if (_dBaActive) _dBaActive(e.touches[0].clientX);
  }, { passive: true });
  document.addEventListener('touchend',  function() { _dBaActive = null; }, { passive: true });

  function dentalInitBaSliders(root) {
    (root || document).querySelectorAll('[data-dental-ba]').forEach(function(ba) {
      if (ba._dBaInit) return;
      ba._dBaInit = true;
      var handle  = ba.querySelector('[data-dental-ba-handle]');
      var afterEl = ba.querySelector('.after');
      if (!handle || !afterEl) return;
      function setPos(pct) {
        pct = Math.max(5, Math.min(95, pct));
        handle.style.left = pct + '%';
        afterEl.style.clipPath = 'inset(0 0 0 ' + pct + '%)';
      }
      function pctFrom(clientX) {
        var r = ba.getBoundingClientRect();
        return ((clientX - r.left) / r.width) * 100;
      }
      setPos(50);
      handle.addEventListener('mousedown', function(e) { e.preventDefault(); _dBaActive = function(x) { setPos(pctFrom(x)); }; });
      handle.addEventListener('touchstart', function() { _dBaActive = function(x) { setPos(pctFrom(x)); }; }, { passive: true });
      ba.addEventListener('click', function(e) { if (e.target !== handle) setPos(pctFrom(e.clientX)); });
    });
  }
  dentalInitBaSliders();

  // ── Cases Modal ──
  (function() {
    var modal    = document.getElementById('dental-modal');
    var openBtn  = document.getElementById('dental-modal-open');
    var closeBtn = document.getElementById('dental-modal-close');
    var backdrop = document.getElementById('dental-modal-backdrop');
    var grid     = document.getElementById('dental-modal-grid');
    var filtersEl= document.getElementById('dental-modal-filters');
    var emptyEl  = document.getElementById('dental-modal-empty');
    if (!modal || !openBtn || !grid) return;

    var CASES = (window.__dentalModalCases || []).map(function(c) {
      return [c.category, c.categoryLabel, c.title, c.desc, c.duration, c.beforeImage || '/images/dental/patient-smile-checkup.jpg', c.afterImage || '/images/dental/clinic-interior.jpg'];
    });

    var built = false;
    function buildCards() {
      if (built) return;
      built = true;
      CASES.forEach(function(c, i) {
        var bImg = c[5];
        var aImg = c[6];
        var el = document.createElement('article');
        el.className = 'bg-white rounded-2xl overflow-hidden ring-inset-1';
        el.setAttribute('data-modal-category', c[0]);
        el.innerHTML =
          '<div class="ba aspect-[4/3] bg-soft" data-dental-ba>' +
            '<img src="'+bImg+'" alt="До" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async"/>' +
            '<div class="after"><img src="'+aImg+'" alt="После" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async"/></div>' +
            '<span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-white/90 text-[10px] font-bold uppercase tracking-wider pointer-events-none">До</span>' +
            '<span class="absolute top-2 right-2 px-2 py-0.5 rounded-md bg-ink text-white text-[10px] font-bold uppercase tracking-wider pointer-events-none">После</span>' +
            '<div class="handle" data-dental-ba-handle></div>' +
          '</div>' +
          '<div class="p-4">' +
            '<div class="flex items-center gap-2 text-xs">' +
              '<span class="px-2 py-0.5 rounded-md bg-soft text-muted">'+c[1]+'</span>' +
              '<span class="text-muted">·</span><span class="text-muted">'+c[4]+'</span>' +
            '</div>' +
            '<h3 class="font-semibold mt-2 text-sm leading-snug">'+c[2]+'</h3>' +
            '<p class="dental-modal-desc text-xs text-muted mt-1">'+c[3]+'</p>' +
          '</div>';
        grid.appendChild(el);
      });
      dentalInitBaSliders(grid);
    }

    function openModal() {
      buildCards();
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', function(e) { e.preventDefault(); openModal(); });
    if (closeBtn)  closeBtn.addEventListener('click', closeModal);
    if (backdrop)  backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });

    if (filtersEl) {
      filtersEl.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-modal-filter]');
        if (!btn) return;
        var filter = btn.getAttribute('data-modal-filter');
        filtersEl.querySelectorAll('[data-modal-filter]').forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var cards = grid.querySelectorAll('[data-modal-category]');
        var visible = 0;
        cards.forEach(function(card) {
          var match = filter === 'all' || card.getAttribute('data-modal-category') === filter;
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        if (emptyEl) emptyEl.style.display = visible === 0 ? '' : 'none';
      });
    }
  })();

  document.querySelectorAll('[data-dental-form]').forEach(function(form) {
    var btn = form.querySelector('[data-dental-submit]');
    if (!btn) return;
    btn.addEventListener('click', function() {
      dentalClearErrors(form);
      var valid = true;

      var nameEl = form.querySelector('[data-dental-name]');
      if (nameEl) {
        var name = nameEl.value.trim();
        if (name.length < 2) {
          dentalShowError(nameEl, (window.__dentalFormMessages || {}).nameError || 'Введите имя (минимум 2 символа)');
          valid = false;
        }
      }

      var phoneEl = form.querySelector('[data-dental-phone]');
      if (phoneEl) {
        if (!dentalValidatePhone(phoneEl.value)) {
          dentalShowError(phoneEl, (window.__dentalFormMessages || {}).phoneError || 'Введите корректный российский номер телефона');
          valid = false;
        }
      }

      if (!valid) return;

      form.querySelectorAll('input, textarea').forEach(function(el) { el.value = ''; });
      dentalShowToast();
    });
  });
</script>

</body>
</html>
