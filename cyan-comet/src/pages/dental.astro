---
import '../styles/dental.css';
const title = "Имплантация зубов под ключ в Москве — цена от 45 000 ₽ | Имплант.Центр";
const description = "Имплантация зубов в Москве под ключ: Straumann, Nobel Biocare, All-on-4 и All-on-6. Бесплатная консультация и КТ, рассрочка 0% до 24 мес., фиксированная цена в договоре. 17 лет опыта, 4 800+ установленных имплантов Straumann и Nobel.";
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0A1426" media="(prefers-color-scheme: dark)" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content="Имплантация зубов под ключ в Москве — Имплант.Центр" />
  <meta property="og:description" content="Имплантация All-on-4, All-on-6, имплантация одного зуба. Бесплатная КТ, рассрочка 0%, фиксированная цена в договоре." />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
</head>
<body>

<!-- HEADER -->
<header class="sticky top-0 z-40 bg-white/85 border-b border-border">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between">
    <a href="#" class="flex items-center gap-2">
      <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-ink text-white">
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3c2.5 0 4 1.2 4 3 0 1.4-.6 2.4-1 4.5-.4 2-.5 6-1.5 9-.6 1.7-2.2 1.7-2.8 0-1-3-1.1-7-1.5-9-.4-2.1-1-3.1-1-4.5 0-1.8 1.5-3 4-3Z"/>
        </svg>
      </span>
      <span class="display text-xl tracking-tight">Имплант<span class="text-accent-2">.</span>Центр</span>
    </a>
    <nav class="hidden lg:flex items-center gap-7 text-sm text-muted">
      <a href="#solutions" class="hover:text-ink">Методы</a>
      <a href="#pricing" class="hover:text-ink">Цены</a>
      <a href="#cases" class="hover:text-ink">Кейсы</a>
      <a href="#doctors" class="hover:text-ink">Врачи</a>
      <a href="#guarantee" class="hover:text-ink">Гарантии</a>
      <a href="#faq" class="hover:text-ink">FAQ</a>
    </nav>
    <div class="flex items-center gap-3">
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Переключить тему">
        <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
        </svg>
      </button>
      <a href="tel:+74950000000" class="hidden md:inline text-sm font-semibold tracking-tight num">+7 495 000-00-00</a>
      <a href="#cta" class="inline-flex items-center h-10 md:h-11 px-4 md:px-5 rounded-xl bg-ink text-white text-sm font-semibold hover:bg-ink-2 transition">Записаться</a>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-soft via-bg to-bg"></div>
    <div class="absolute inset-0 grain opacity-60"></div>
    <div class="absolute -top-32 -right-40 w-[600px] h-[600px] rounded-full bg-accent/10 blur-3xl"></div>
  </div>

  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8 pt-12 md:pt-20 pb-16 md:pb-24">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">

      <!-- LEFT: offer + benefits + CTA -->
      <div class="lg:col-span-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white ring-inset-1 text-xs font-medium text-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          Имплантация в Москве · приём в день обращения · свободно 4 окна
        </div>
        <h1 class="display mt-6 text-[44px] leading-[1.02] sm:text-6xl lg:text-[72px] font-medium">
          Имплантация зубов<br/>
          <span class="italic font-light text-ink-2">в Москве</span> —<br/>
          <span class="relative inline-block">
            под ключ от 45 000 ₽
            <svg class="absolute -bottom-2 left-0 w-full" height="14" viewBox="0 0 400 14" fill="none" preserveAspectRatio="none">
              <path d="M2 8 Q 100 2 200 7 T 398 6" stroke="#2DD4BF" stroke-width="4" stroke-linecap="round" fill="none"/>
            </svg>
          </span>
        </h1>
        <p class="mt-6 text-base md:text-lg text-muted max-w-xl">
          Имплантация одного зуба, All-on-4 и All-on-6 в Москве. Полный цикл от диагностики и компьютерной томографии до установки постоянных коронок. Системы Straumann и Nobel Biocare. Принимаем сложные случаи после отказов в других клиниках.
        </p>

        <ul class="mt-7 grid sm:grid-cols-2 gap-3 max-w-xl text-sm">
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 inline-flex w-5 h-5 rounded-full bg-accent/15 text-accent-2 items-center justify-center shrink-0">
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
            </span>
            Бесплатная КТ-диагностика и план лечения
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 inline-flex w-5 h-5 rounded-full bg-accent/15 text-accent-2 items-center justify-center shrink-0">
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
            </span>
            Рассрочка 0% от банков-партнёров до 24 мес.
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 inline-flex w-5 h-5 rounded-full bg-accent/15 text-accent-2 items-center justify-center shrink-0">
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
            </span>
            Имплантация под седацией — без боли и страха
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 inline-flex w-5 h-5 rounded-full bg-accent/15 text-accent-2 items-center justify-center shrink-0">
              <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
            </span>
            Фиксированная цена имплантации в договоре
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#cta" class="inline-flex items-center h-12 px-6 rounded-xl bg-ink text-white font-semibold hover:bg-ink-2 transition shadow-card">
            Записаться на консультацию имплантолога
          </a>
          <a href="#pricing" class="inline-flex items-center h-12 px-1 text-ink font-semibold underline decoration-accent decoration-2 underline-offset-4 hover:decoration-ink-2">
            Узнать цену имплантации →
          </a>
        </div>

        <div class="mt-10 flex items-center gap-5">
          <div class="flex -space-x-3">
            <div class="w-10 h-10 rounded-full ring-2 ring-white bg-gradient-to-br from-orange-200 to-rose-300"></div>
            <div class="w-10 h-10 rounded-full ring-2 ring-white bg-gradient-to-br from-sky-200 to-indigo-300"></div>
            <div class="w-10 h-10 rounded-full ring-2 ring-white bg-gradient-to-br from-emerald-200 to-teal-400"></div>
            <div class="w-10 h-10 rounded-full ring-2 ring-white bg-gradient-to-br from-amber-200 to-pink-300"></div>
          </div>
          <div class="text-sm">
            <div class="flex items-center gap-1 text-amber-500">
              <span>★★★★★</span>
              <span class="text-ink font-semibold ml-1 num">4.9</span>
            </div>
            <div class="text-muted">2 100+ отзывов · Яндекс, ПроДокторов</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: placeholder visual + floating form card -->
      <div class="lg:col-span-6">
        <div class="relative lg:pb-12">
          <!-- decorative shapes -->
          <div class="absolute -top-4 -left-4 w-24 h-24 rounded-2xl bg-accent/20 -z-10"></div>
          <div class="absolute -bottom-6 -right-6 w-40 h-40 rounded-full bg-ink/5 -z-10"></div>

          <!-- Hero image -->
          <div class="relative aspect-[4/5] sm:aspect-[5/6] lg:aspect-[4/5] rounded-3xl overflow-hidden shadow-lift bg-soft">
            <img src="/images/dental/hero-dental-consultation.jpg"
                 alt="Консультация имплантолога в клинике Имплант.Центр"
                 class="absolute inset-0 w-full h-full object-cover"
                 loading="eager" decoding="async" />

            <!-- Bottom gradient overlay -->
            <div class="absolute inset-x-0 bottom-0 h-40 pointer-events-none" style="background: linear-gradient(to top, rgba(10,31,54,0.30), transparent);"></div>

            <!-- Doctor on duty caption -->
            <div class="absolute top-5 left-5 inline-flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white shadow-card" style="backdrop-filter: blur(8px);">
              <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
              <span class="text-xs font-medium">На приёме · Иванов А.С.</span>
            </div>

            <!-- Floating stat -->
            <div class="hidden sm:block absolute bottom-5 left-5 p-4 rounded-2xl bg-white shadow-card" style="max-width: 220px; backdrop-filter: blur(8px);">
              <div class="flex items-baseline gap-2">
                <span class="display text-3xl num">4 800<span class="text-accent-2">+</span></span>
              </div>
              <div class="text-xs text-muted mt-1">установленных имплантов за 17 лет работы</div>
            </div>
          </div>

          <!-- Floating form card -->
          <div class="mt-6 lg:mt-0 lg:absolute lg:-bottom-4 lg:-right-4 lg:w-[340px] xl:w-[360px] bg-white rounded-3xl shadow-lift p-5 md:p-6 ring-inset-1">
            <div class="flex items-center justify-between mb-1">
              <div class="text-xs font-semibold uppercase tracking-widest text-accent-2">Бесплатно</div>
              <div class="text-xs text-muted">≈ 2 минуты</div>
            </div>
            <h3 class="display text-xl md:text-2xl leading-tight">
              Запись на консультацию
            </h3>
            <p class="text-sm text-muted mt-1.5">Перезвоним в течение 15 минут.</p>

            <form class="mt-4 space-y-2.5" data-dental-form>
              <label class="block">
                <span class="sr-only">Имя</span>
                <input type="text" placeholder="Ваше имя" data-dental-name
                  class="w-full h-11 px-4 rounded-xl bg-soft border border-transparent focus:border-ink focus:bg-white outline-none transition text-sm" />
                <span class="dental-field-error"></span>
              </label>
              <label class="block">
                <span class="sr-only">Телефон</span>
                <input type="tel" placeholder="+7 (___) ___-__-__" data-dental-phone
                  class="w-full h-11 px-4 rounded-xl bg-soft border border-transparent focus:border-ink focus:bg-white outline-none transition num text-sm" />
                <span class="dental-field-error"></span>
              </label>
              <button type="button" data-dental-submit
                class="w-full h-11 rounded-xl bg-ink text-white font-semibold hover:bg-ink-2 transition text-sm">
                Записаться →
              </button>
              <p class="text-[11px] text-muted leading-relaxed">
                Нажимая кнопку, вы соглашаетесь с <a href="#" class="underline">политикой обработки персональных данных</a>.
              </p>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- TRUST BAR -->
<section class="bg-ink text-white">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-7">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-y-5 gap-x-4 items-center">
      <div>
        <div class="display text-2xl md:text-3xl num">17<span class="text-accent">+</span></div>
        <div class="text-xs text-white/60">лет имплантации в Москве</div>
      </div>
      <div>
        <div class="display text-2xl md:text-3xl num">4 800<span class="text-accent">+</span></div>
        <div class="text-xs text-white/60">установленных имплантов</div>
      </div>
      <div>
        <div class="display text-2xl md:text-3xl num">12</div>
        <div class="text-xs text-white/60">врачей-имплантологов в штате</div>
      </div>
      <div>
        <div class="display text-2xl md:text-3xl num">4.9 ★</div>
        <div class="text-xs text-white/60">рейтинг на Яндекс и ПроДокторов</div>
      </div>
      <div class="col-span-2 md:col-span-1">
        <div class="text-xs text-white/60">Лицензия</div>
        <div class="text-sm font-medium num">ЛО-77-01-123456</div>
      </div>
    </div>
  </div>
</section>

<!-- PAINS -->
<section class="py-16 md:py-24">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8">
    <div class="max-w-2xl">
      <div class="text-xs font-semibold tracking-widest text-accent-2 uppercase">Кому нужна имплантация</div>
      <h2 class="display text-3xl md:text-5xl mt-3 leading-tight">
        Если откладывать лечение зубов,<br class="hidden md:block"/>
        <span class="italic font-light text-muted">имплантация становится сложнее и дороже</span>
      </h2>
    </div>

    <div class="mt-10 md:mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="p-6 rounded-2xl bg-white ring-inset-1 hover:shadow-card transition">
        <div class="w-10 h-10 rounded-xl bg-soft flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path d="M8 14s1.5 2 4 2 4-2 4-2"/><circle cx="9" cy="9" r="1"/><circle cx="15" cy="9" r="1"/><path d="M12 3a9 9 0 1 0 9 9"/>
          </svg>
        </div>
        <h3 class="font-semibold text-lg">Не хватает передних зубов</h3>
        <p class="text-sm text-muted mt-1.5">Стесняюсь улыбаться, закрываю рот рукой на фотографиях, избегаю встреч и публичных мест.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white ring-inset-1 hover:shadow-card transition">
        <div class="w-10 h-10 rounded-xl bg-soft flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path d="M4 12h16M4 12l4-4M4 12l4 4M20 6v12"/>
          </svg>
        </div>
        <h3 class="font-semibold text-lg">Съёмный протез доставляет дискомфорт</h3>
        <p class="text-sm text-muted mt-1.5">Натирает дёсны, выпадает во время еды, мешает чётко говорить. Хочу заменить на несъёмный протез на имплантах.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white ring-inset-1 hover:shadow-card transition">
        <div class="w-10 h-10 rounded-xl bg-soft flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path d="M12 2v6M12 16v6M2 12h6M16 12h6"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <h3 class="font-semibold text-lg">Боюсь имплантации и боли</h3>
        <p class="text-sm text-muted mt-1.5">Слышал, что установка имплантов — это долго и больно. Хочу пройти лечение под седацией, без стресса.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white ring-inset-1 hover:shadow-card transition">
        <div class="w-10 h-10 rounded-xl bg-soft flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path d="M3 7h18M5 7v12h14V7M9 11h6"/>
          </svg>
        </div>
        <h3 class="font-semibold text-lg">Атрофия кости — отказали в других клиниках</h3>
        <p class="text-sm text-muted mt-1.5">В двух клиниках сказали, что без костной пластики имплантация невозможна. Ищу клинику, которая берётся за сложные случаи.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white ring-inset-1 hover:shadow-card transition">
        <div class="w-10 h-10 rounded-xl bg-soft flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-ink-2" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <h3 class="font-semibold text-lg">Не понимаю итоговую цену имплантации</h3>
        <p class="text-sm text-muted mt-1.5">Везде «от» — реальная стоимость имплантации зуба всплывает только после диагностики и осмотра.</p>
      </div>
      <div class="p-6 rounded-2xl bg-ink text-white relative overflow-hidden">
        <div class="absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-accent/20 blur-2xl"></div>
        <h3 class="font-semibold text-lg">Узнаёте себя хотя бы в одном пункте?</h3>
        <p class="text-sm text-white/70 mt-1.5">Запишитесь на бесплатную консультацию имплантолога с КТ-диагностикой — подберём подходящее решение.</p>
        <a href="#cta" class="mt-4 inline-flex items-center text-sm font-semibold text-accent hover:text-white transition">
          Записаться →
        </a>
      </div>
    </div>
  </div>
</section>

<!-- SOLUTIONS -->
<section id="solutions" class="bg-soft py-16 md:py-24 relative">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6">
        <div class="relative aspect-[4/5] rounded-3xl overflow-hidden shadow-lift bg-white ring-inset-1">
          <img src="/images/dental/clinic-interior.jpg"
               alt="Кабинет имплантации клиники Имплант.Центр"
               class="absolute inset-0 w-full h-full object-cover"
               loading="lazy" decoding="async" />
          <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-ink/40 to-transparent pointer-events-none"></div>
          <div class="absolute top-5 left-5 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/95 backdrop-blur text-xs font-medium shadow-card">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Цифровое 3D-планирование · КТ Planmeca
          </div>
          <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-white/95 backdrop-blur shadow-card">
            <div class="text-xs font-semibold uppercase tracking-widest text-accent-2">All-on-4</div>
            <div class="text-sm mt-1">Несъёмный протез на 4 имплантах с фиксацией в день операции</div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="text-xs font-semibold tracking-widest text-accent-2 uppercase">Методы имплантации</div>
        <h2 class="display text-3xl md:text-5xl mt-3 leading-tight">
          All-on-4 — имплантация<br/>при полном отсутствии<br/><span class="italic font-light">зубов на челюсти</span>
        </h2>
        <p class="text-muted mt-5 max-w-lg">
