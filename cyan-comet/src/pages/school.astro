---
const title = "Курсы английского языка онлайн — разговорный английский с преподавателем | SpeakFlow";
const description = "Онлайн-курсы английского языка для взрослых и подростков: разговорный английский, подготовка к собеседованию, английский для работы и путешествий. Бесплатный вводный урок, персональный план, преподаватели с опытом.";
---

<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light only" />
  <meta name="theme-color" content="#FFF8EC" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content="Курсы английского языка онлайн — SpeakFlow" />
  <meta property="og:description" content="Разговорный английский, английский для работы и путешествий. Вводный урок бесплатно, персональный план и живые занятия с преподавателем." />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: #FFF8EC; }
    body {
      font-family: "Nunito", system-ui, sans-serif;
      color: #182033;
      background: #FFF8EC;
      -webkit-font-smoothing: antialiased;
      margin: 0;
    }
    .display { font-family: "Onest", system-ui, sans-serif; letter-spacing: -0.035em; }
    .num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }
    section[id] { scroll-margin-top: 88px; }
    @media (max-width: 1023px) { body { padding-bottom: 88px; } }
    /* ── Price cards ── */
    .school-price-card {
      cursor: pointer;
      transition: box-shadow 0.2s ease, transform 0.15s ease, outline-color 0.15s ease;
      display: flex;
      flex-direction: column;
    }
    .school-price-card:hover {
      transform: translateY(-2px);
    }
    .school-price-card.active {
      outline: 2px solid #6D5DF6;
      outline-offset: 2px;
      box-shadow: 0 8px 24px rgba(109,93,246,.18), 0 24px 60px rgba(24,32,51,.14);
    }
    /* Light cards get subtle tint when active */
    .school-price-card.active:not(.bg-ink) {
      background: #FAF8FF;
    }
    /* Dark middle card: accent ring only, no bg change */
    .school-price-card.active.bg-ink {
      outline-color: #6D5DF6;
    }
    /* Ensure CTA button stays at bottom regardless of content height */
    .school-price-card .school-price-cta {
      margin-top: auto;
    }

    /* ── FAQ smooth animation ── */
    .school-faq details summary {
      cursor: pointer;
      list-style: none;
    }
    .school-faq details summary::-webkit-details-marker { display: none; }
    /* Hide native marker in Firefox */
    .school-faq details > summary { display: flex; }
    .school-faq details .faq-body {
      overflow: hidden;
      max-height: 0;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.28s ease;
      opacity: 0;
    }
    .school-faq details.open .faq-body {
      max-height: 400px;
      opacity: 1;
    }
    .school-faq details {
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .school-faq details.open {
      background: #FAF8FF;
      border-color: #6D5DF6;
    }
    .school-faq details.open summary {
      color: #6D5DF6;
    }
    .school-faq-icon {
      font-size: 22px;
      line-height: 1;
      min-width: 28px;
      height: 28px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.28s ease;
      user-select: none;
    }
    .school-faq details.open .school-faq-icon {
      transform: rotate(45deg);
    }

    details[open] summary .chev { transform: rotate(45deg); }

    .paper {
      background:
        radial-gradient(circle at 15% 20%, rgba(109,93,246,.12), transparent 28%),
        radial-gradient(circle at 85% 10%, rgba(255,122,89,.12), transparent 30%),
        radial-gradient(circle at 80% 78%, rgba(88,201,167,.14), transparent 32%),
        #FFF8EC;
    }
    .note {
      background-image: linear-gradient(rgba(232,217,193,.65) 1px, transparent 1px);
      background-size: 100% 28px;
    }
    .bubble-tail::after {
      content: "";
      position: absolute;
      left: 28px;
      bottom: -10px;
      border-width: 10px 10px 0 0;
      border-style: solid;
      border-color: #FFFFFF transparent transparent transparent;
    }
    .sticker { transform: rotate(-2deg); }
    .sticker:nth-child(even) { transform: rotate(2deg); }
    .lesson-card {
      background:
        linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.86)),
        repeating-linear-gradient(90deg, rgba(109,93,246,.08) 0, rgba(109,93,246,.08) 1px, transparent 1px, transparent 16px);
    }

    /* Tailwind-like utilities needed by this page */
    .max-w-container { max-width: 1240px; }
    .shadow-soft { box-shadow: 0 2px 4px rgba(24,32,51,.04), 0 16px 40px rgba(24,32,51,.08); }
    .shadow-lift { box-shadow: 0 24px 60px rgba(24,32,51,.14); }
    a { text-decoration: none; color: inherit; }
  </style>

  <!-- Tailwind CDN for utility classes -->
  <script is:inline>
    // We load tailwind config inline — no npm package needed
  </script>
  <script src="https://cdn.tailwindcss.com" is:inline></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink:      '#182033',
            'ink-2':  '#0F172A',
            bg:       '#FFF8EC',
            soft:     '#F4E9D8',
            card:     '#FFFFFF',
            border:   '#E8D9C1',
            muted:    '#6B6256',
            accent:   '#6D5DF6',
            'accent-2': '#5145CD',
            coral:    '#FF7A59',
            mint:     '#58C9A7',
            lemon:    '#F6C85F',
            blue:     '#5BA7FF',
          },
          fontFamily: {
            display: ['Onest', 'system-ui', 'sans-serif'],
            sans:    ['Nunito', 'system-ui', 'sans-serif'],
          },
          boxShadow: {
            soft: '0 2px 4px rgba(24,32,51,.04), 0 16px 40px rgba(24,32,51,.08)',
            lift: '0 24px 60px rgba(24,32,51,.14)',
          },
          maxWidth: { container: '1240px' },
        }
      }
    }
  </script>
</head>

<body class="bg-bg text-ink">

<header class="sticky top-0 z-40 bg-bg/88 backdrop-blur border-b border-border">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between">
    <a href="#" class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-accent text-white shadow-soft">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 5h16v10H8l-4 4z"/><path d="M8 9h8M8 12h5"/>
        </svg>
      </span>
      <span class="display text-2xl font-extrabold">Speak<span class="text-accent">Flow</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-sm font-bold text-muted">
      <a href="#courses" class="hover:text-ink">Курсы</a>
      <a href="#method" class="hover:text-ink">Метод</a>
      <a href="#teachers" class="hover:text-ink">Преподаватели</a>
      <a href="#price" class="hover:text-ink">Цены</a>
      <a href="#reviews" class="hover:text-ink">Отзывы</a>
      <a href="#faq" class="hover:text-ink">FAQ</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="tel:+74950000031" class="hidden md:inline text-sm font-extrabold num">+7 495 000-00-31</a>
      <a href="#cta" class="inline-flex items-center h-10 md:h-11 px-4 md:px-5 rounded-2xl bg-ink text-white text-sm font-extrabold hover:bg-accent transition">Бесплатный урок</a>
    </div>
  </div>
</header>

<main>

<!-- HERO -->
<section class="paper relative overflow-hidden">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8 pt-12 md:pt-18 pb-16 md:pb-24">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-border text-xs font-extrabold text-muted">
          <span class="w-2 h-2 rounded-full bg-mint"></span>
          Онлайн · живые уроки · вводный урок бесплатно
        </div>

        <h1 class="display mt-6 text-[44px] leading-[1.02] sm:text-6xl lg:text-[76px] font-extrabold">
          Курсы английского языка,<br/>
          где вы начинаете<br/>
          <span class="text-accent">говорить вслух</span>
        </h1>

        <p class="mt-6 text-lg text-muted max-w-2xl leading-relaxed">
          Разговорный английский онлайн для работы, путешествий и собеседований. Подберём преподавателя, определим уровень и составим персональный план на вводном уроке.
        </p>

        <div class="mt-8 grid sm:grid-cols-2 gap-3 max-w-2xl">
          <div class="flex items-center gap-3 bg-white/80 border border-border rounded-2xl p-3">
            <span class="w-9 h-9 rounded-xl bg-accent/12 text-accent flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
            </span>
            <div class="text-sm"><b>План под цель</b><br><span class="text-muted">работа, travel, экзамен, speaking</span></div>
          </div>
          <div class="flex items-center gap-3 bg-white/80 border border-border rounded-2xl p-3">
            <span class="w-9 h-9 rounded-xl bg-coral/12 text-coral flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
            </span>
            <div class="text-sm"><b>70% урока — практика</b><br><span class="text-muted">диалоги, ролевые сценарии, ошибки</span></div>
          </div>
          <div class="flex items-center gap-3 bg-white/80 border border-border rounded-2xl p-3">
            <span class="w-9 h-9 rounded-xl bg-mint/12 text-mint flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-7"/></svg>
            </span>
            <div class="text-sm"><b>Прогресс каждую неделю</b><br><span class="text-muted">трекер слов, speaking score, домашка</span></div>
          </div>
          <div class="flex items-center gap-3 bg-white/80 border border-border rounded-2xl p-3">
            <span class="w-9 h-9 rounded-xl bg-lemon/20 text-ink flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
            </span>
            <div class="text-sm"><b>Уроки 25 или 50 минут</b><br><span class="text-muted">утром, вечером или в выходные</span></div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#cta" class="inline-flex h-13 px-7 py-4 rounded-2xl bg-accent text-white font-extrabold hover:bg-accent-2 transition shadow-soft">Записаться на вводный урок</a>
          <a href="#courses" class="inline-flex h-13 px-1 py-4 font-extrabold underline decoration-coral decoration-3 underline-offset-4">Выбрать курс →</a>
        </div>

        <div class="mt-8 flex items-center gap-4 text-sm">
          <div class="flex -space-x-2">
            <div class="w-10 h-10 rounded-full bg-coral border-2 border-bg"></div>
            <div class="w-10 h-10 rounded-full bg-mint border-2 border-bg"></div>
            <div class="w-10 h-10 rounded-full bg-lemon border-2 border-bg"></div>
          </div>
          <div><b class="num">4.9 ★</b> · 18 000+ учеников прошли вводный урок</div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative">
          <div class="absolute -top-6 -right-4 sticker bg-lemon rounded-2xl px-4 py-3 shadow-soft z-10">
            <div class="text-xs font-extrabold uppercase">Today</div>
            <div class="text-sm">free slots: 12</div>
          </div>

          <div class="lesson-card border border-border rounded-[28px] p-5 md:p-6 shadow-lift">
            <div class="bg-white rounded-3xl border border-border p-4">
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-xs text-muted font-extrabold uppercase">Trial lesson</div>
                  <div class="display text-2xl font-extrabold mt-1">Вводный урок</div>
                </div>
                <span class="px-3 py-1 rounded-full bg-mint/15 text-mint text-xs font-extrabold">FREE</span>
              </div>

              <div class="mt-5 rounded-2xl aspect-[4/3] bg-soft relative overflow-hidden">
                <img src="/images/school/hero-student.jpg" alt="Онлайн-урок английского языка с преподавателем SpeakFlow" class="w-full h-full object-cover" loading="eager" />
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="bg-white/90 backdrop-blur rounded-2xl px-4 py-3 shadow-soft text-center">
                    <div class="text-xs text-muted font-bold">Speaking level</div>
                    <div class="display text-4xl font-extrabold text-accent">A2 → B1</div>
                  </div>
                </div>
              </div>

              <form class="mt-5 space-y-3">
                <input class="w-full h-12 px-4 rounded-2xl bg-bg border border-border focus:bg-white focus:border-accent outline-none" placeholder="Ваше имя" />
                <input class="w-full h-12 px-4 rounded-2xl bg-bg border border-border focus:bg-white focus:border-accent outline-none num" placeholder="+7 (___) ___-__-__" />
                <select class="w-full h-12 px-4 rounded-2xl bg-bg border border-border focus:bg-white focus:border-accent outline-none">
                  <option>Цель: разговорный английский</option>
                  <option>Английский для работы</option>
                  <option>Подготовка к собеседованию</option>
                  <option>Английский для путешествий</option>
                  <option>Английский для подростка</option>
                </select>
                <button type="button" class="w-full h-12 rounded-2xl bg-ink text-white font-extrabold hover:bg-accent transition">Подобрать преподавателя →</button>
                <p class="text-[11px] text-muted leading-relaxed">Нажимая кнопку, вы соглашаетесь с политикой обработки данных.</p>
              </form>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- TRUST -->
<section class="bg-white border-y border-border">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-5 divide-x-0 md:divide-x divide-border">
      <div class="p-5 md:p-6">
        <div class="display text-3xl md:text-4xl font-extrabold num text-accent">9 лет</div>
        <div class="text-sm text-muted mt-1">обучаем онлайн</div>
      </div>
      <div class="p-5 md:p-6">
        <div class="display text-3xl md:text-4xl font-extrabold num text-coral">18 000+</div>
        <div class="text-sm text-muted mt-1">учеников на вводном уроке</div>
      </div>
      <div class="p-5 md:p-6">
        <div class="display text-3xl md:text-4xl font-extrabold num text-mint">320+</div>
        <div class="text-sm text-muted mt-1">преподавателей</div>
      </div>
      <div class="p-5 md:p-6">
        <div class="display text-3xl md:text-4xl font-extrabold num text-lemon">4.9 ★</div>
        <div class="text-sm text-muted mt-1">средняя оценка уроков</div>
      </div>
      <div class="p-5 md:p-6 col-span-2 md:col-span-1">
        <div class="display text-3xl md:text-4xl font-extrabold num text-blue">CEFR</div>
        <div class="text-sm text-muted mt-1">A1–C1, уровни по шкале</div>
      </div>
    </div>
  </div>
</section>

<!-- COURSES -->
<section id="courses" class="py-16 md:py-24">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8">
    <div class="max-w-3xl mb-10">
      <div class="text-xs font-extrabold tracking-widest text-accent uppercase">Курсы</div>
      <h2 class="display text-3xl md:text-5xl font-extrabold mt-3 leading-tight">Выберите английский под вашу задачу</h2>
      <p class="text-muted mt-4 text-lg">Не учим "всё подряд". На вводном уроке определяем цель и собираем маршрут: темы, словарь, преподаватель, формат и график.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      <article class="bg-white rounded-[28px] border border-border p-6 shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-accent/12 text-accent flex items-center justify-center mb-5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
        </div>
        <h3 class="display text-xl font-extrabold">Разговорный английский</h3>
        <p class="text-sm text-muted mt-2">Для тех, кто понимает, но не может говорить уверенно.</p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold">
          <span class="px-2 py-1 rounded-full bg-bg">speaking</span><span class="px-2 py-1 rounded-full bg-bg">A2–B2</span>
        </div>
      </article>

      <article class="bg-white rounded-[28px] border border-border p-6 shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-coral/12 text-coral flex items-center justify-center mb-5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4 6 4v14"/><path d="M9 10h6M9 14h6"/></svg>
        </div>
        <h3 class="display text-xl font-extrabold">Английский для работы</h3>
        <p class="text-sm text-muted mt-2">Встречи, письма, small talk, презентации и созвоны.</p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold">
          <span class="px-2 py-1 rounded-full bg-bg">business</span><span class="px-2 py-1 rounded-full bg-bg">B1–C1</span>
        </div>
      </article>

      <article class="bg-white rounded-[28px] border border-border p-6 shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-mint/12 text-mint flex items-center justify-center mb-5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
        </div>
        <h3 class="display text-xl font-extrabold">Собеседование</h3>
        <p class="text-sm text-muted mt-2">Резюме, ответы на вопросы, рассказ о проектах и опыте.</p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold">
          <span class="px-2 py-1 rounded-full bg-bg">interview</span><span class="px-2 py-1 rounded-full bg-bg">fast track</span>
        </div>
      </article>

      <article class="bg-white rounded-[28px] border border-border p-6 shadow-soft">
        <div class="w-12 h-12 rounded-2xl bg-lemon/25 text-ink flex items-center justify-center mb-5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19l16-7-16-7v5l10 2-10 2z"/></svg>
        </div>
        <h3 class="display text-xl font-extrabold">Для путешествий</h3>
        <p class="text-sm text-muted mt-2">Аэропорт, отель, кафе, аренда авто, экстренные ситуации.</p>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold">
          <span class="px-2 py-1 rounded-full bg-bg">travel</span><span class="px-2 py-1 rounded-full bg-bg">A1–B1</span>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- METHOD -->
<section id="method" class="py-16 md:py-24 bg-soft">
  <div class="max-w-container mx-auto px-4 md:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <div class="text-xs font-extrabold tracking-widest text-accent uppercase">Метод</div>
        <h2 class="display text-3xl md:text-5xl font-extrabold mt-3 leading-tight">Урок похож не на лекцию, а на тренировку речи</h2>
        <p class="text-muted mt-5 text-lg leading-relaxed">Каждый урок собирается вокруг ситуации, где вам нужен английский: звонок, презентация, аэропорт, разговор с коллегой или интервью.</p>
      </div>

      <div class="lg:col-span-7">
