<!-- Price card interactivity -->
<script is:inline>
(function () {
  var cards = document.querySelectorAll('.school-price-card');
  if (!cards.length) return;

  function setActive(el) {
    cards.forEach(function (c) { c.classList.remove('active'); });
    el.classList.add('active');
  }

  cards.forEach(function (card) {
    card.addEventListener('click', function () { setActive(card); });
  });

  // Middle card active by default
  var mid = cards[Math.floor((cards.length - 1) / 2)];
  if (mid) setActive(mid);
})();
</script>

<!-- FAQ smooth animation -->
<script is:inline>
(function () {
  var faqDetails = document.querySelectorAll('.school-faq details');
  if (!faqDetails.length) return;

  function getIcon(detail) {
    return detail.querySelector('.school-faq-icon');
  }

  function openDetail(detail) {
    detail.classList.add('open');
    var icon = getIcon(detail);
    if (icon) icon.textContent = '+'; // rotation via CSS handles visual
  }

  function closeDetail(detail) {
    detail.classList.remove('open');
  }

  // Intercept all native toggle behaviour so we control state exclusively
  faqDetails.forEach(function (detail) {
    // Prevent native open/close toggling
    detail.addEventListener('toggle', function (e) {
      // Keep native open in sync with our class — if native fired close while we want open, re-open
      if (detail.classList.contains('open') && !detail.open) {
        detail.open = true;
      }
      if (!detail.classList.contains('open') && detail.open) {
        detail.open = false;
      }
    });

    var summary = detail.querySelector('summary');
    if (!summary) return;

    summary.addEventListener('click', function (e) {
      e.preventDefault();
      var isOpen = detail.classList.contains('open');
      // Close all
      faqDetails.forEach(function (d) {
        if (d.classList.contains('open')) {
          closeDetail(d);
          d.open = false;
        }
      });
      // Open clicked if it was closed
      if (!isOpen) {
        openDetail(detail);
        detail.open = true;
      }
    });
  });

  // Open first by default
  openDetail(faqDetails[0]);
  faqDetails[0].open = true;
})();
</script>

