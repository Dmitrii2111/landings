                <span id="case-badge" class="text-xs font-semibold px-2.5 py-1 rounded-full" style="background: rgba(194,65,12,0.1); color: var(--color-accent);"></span>
                <span id="case-area" class="text-xs" style="color: var(--color-muted);"></span>
              </div>
              <h3 id="case-title" class="font-semibold text-lg mb-1" style="color: var(--color-ink-2);"></h3>
              <p id="case-desc" class="text-sm" style="color: var(--color-muted);"></p>
            </div>
            <div class="flex flex-col gap-1 text-sm sm:items-end sm:text-right" style="color: var(--color-muted);">
              <span>Срок: <strong id="case-days" style="color: var(--color-ink);"></strong></span>
              <span>Материалы: по ведомости</span>
              <span id="case-price" class="num font-semibold text-base mt-1" style="color: var(--color-ink);"></span>
              <span class="text-xs">только работы</span>
            </div>
          </div>
        </div>

        <!-- Case selectors -->
        <div id="case-selectors" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4"></div>

      </div>

      <script is:inline>
      (function () {
        var IMGS = {
          living:   '/images/remont/case-prime-park-01-living.jpg',
          kitchen:  '/images/remont/case-prime-park-02-kitchen.jpg',
          bedroom:  '/images/remont/case-prime-park-03-bedroom.jpg',
          bathroom: '/images/remont/case-prime-park-04-bathroom.jpg',
          floor:    '/images/remont/case-prime-park-06-details-floor.jpg',
          light:    '/images/remont/case-prime-park-07-details-light.jpg',
          process:  '/images/remont/case-prime-park-08-process.jpg',
          before:   '/images/remont/case-prime-park-09-before.jpg',
          after:    '/images/remont/case-prime-park-10-after.jpg',
        };
        var CAPS = {
          living:'Гостиная', kitchen:'Кухня', bedroom:'Спальня',
          bathroom:'Санузел', floor:'Деталь пола', light:'Свет',
          process:'Процесс', before:'До ремонта', after:'После ремонта',
        };
        var CASES = [
          { title:'ЖК «Прайм Парк», Хорошёвское шоссе', badge:'Дизайнерский', area:'72 м²', days:'91 день', price:'2 304 000 ₽',
            desc:'Дизайнерский ремонт с авторским надзором. Скрытое освещение, кастомные ниши, тёплый пол во всех помещениях. Сдан в срок.',
            photos:['living','kitchen','bedroom','bathroom','floor','light','process','before','after'] },
          { title:'Вторичка на Таганке', badge:'Капитальный', area:'88 м²', days:'78 дней', price:'2 420 000 ₽',
            desc:'Капитальный ремонт с демонтажом старой отделки, заменой электрики, сантехники и выравниванием стен по маякам.',
            photos:['before','process','bathroom','kitchen','floor','living','light','bedroom','after'] },
          { title:'ЖК «Серебряный фонтан»', badge:'Под аренду', area:'45 м²', days:'45 дней', price:'850 000 ₽',
            desc:'Ремонт квартиры под сдачу в аренду: практичные материалы, быстрые сроки, износостойкая отделка и нейтральный интерьер.',
            photos:['kitchen','living','bedroom','floor','bathroom','after','process','light','before'] },
          { title:'ЖК «Бадаевский»', badge:'Премиум', area:'110 м²', days:'92 дня', price:'4 200 000 ₽',
            desc:'Дизайнерский ремонт бизнес-класса с инженерной подготовкой, сложным освещением, натуральными фактурами и контролем комплектации.',
            photos:['living','light','kitchen','bathroom','bedroom','floor','after','process','before'] },
        ];

        var activeCase = 0;
        var slideIdx   = 0;
        var timer      = null;
        var reduced    = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        var track     = document.getElementById('case-track');
        var dotsEl    = document.getElementById('case-dots');
        var captionEl = document.getElementById('case-caption');
        var counterEl = document.getElementById('case-counter');
        var totalEl   = document.getElementById('case-total');
        var infoEl    = document.getElementById('case-info');
        var titleEl   = document.getElementById('case-title');
        var badgeEl   = document.getElementById('case-badge');
        var areaEl    = document.getElementById('case-area');
        var daysEl    = document.getElementById('case-days');
        var priceEl   = document.getElementById('case-price');
        var descEl    = document.getElementById('case-desc');
        var selectEl  = document.getElementById('case-selectors');

        if (!track || !selectEl) return;

        // Build selector cards
        CASES.forEach(function (c, i) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.style.cssText = 'text-align:left;border-radius:12px;overflow:hidden;width:100%;border:2px solid transparent;background:white;box-shadow:0 2px 8px rgba(31,41,55,.04);cursor:pointer;transition:border-color .2s,box-shadow .2s;';
          btn.innerHTML =
            '<div style="aspect-ratio:16/9;overflow:hidden;background:#f0ede7;">' +
              '<img src="' + IMGS[c.photos[0]] + '" alt="' + c.title + '" style="width:100%;height:100%;object-fit:cover;" loading="lazy" />' +
            '</div>' +
            '<div style="padding:10px 12px;">' +
              '<div style="display:flex;align-items:center;gap:6px;margin-bottom:5px;">' +
                '<span style="font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:rgba(194,65,12,0.1);color:#C2410C;">' + c.badge + '</span>' +
                '<span style="font-size:11px;color:#6B6F76;">' + c.area + '</span>' +
              '</div>' +
              '<div style="font-size:13px;font-weight:600;color:#111827;line-height:1.3;">' + c.title + '</div>' +
              '<div style="font-size:11px;margin-top:3px;color:#6B6F76;">' + c.days + ' · ' + c.price + '</div>' +
            '</div>';
          btn.addEventListener('click', function () { activateCase(i); });
          selectEl.appendChild(btn);
        });

        function buildSlides (idx) {
          var c = CASES[idx];
          track.innerHTML = '';
          c.photos.forEach(function (key) {
            var slide = document.createElement('div');
            slide.style.cssText = 'width:100%;height:100%;flex-shrink:0;background:linear-gradient(135deg,#2d2d2d,#1a1a1a);';
            var img = document.createElement('img');
            img.src = IMGS[key]; img.alt = CAPS[key];
            img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
            img.loading = 'lazy';
            slide.appendChild(img);
            track.appendChild(slide);
          });
          totalEl.textContent = c.photos.length;
          dotsEl.innerHTML = '';
          c.photos.forEach(function (key, j) {
            var d = document.createElement('button');
            d.setAttribute('role', 'tab');
            d.setAttribute('aria-label', CAPS[key]);
            d.style.cssText = 'width:6px;height:6px;border-radius:50%;border:none;padding:0;cursor:pointer;transition:opacity .2s,transform .2s;background:rgba(255,255,255,0.9);';
            d.addEventListener('click', function () { goToSlide(j); });
            dotsEl.appendChild(d);
          });
        }

        function updateCarousel () {
          var c = CASES[activeCase];
          track.style.transform = 'translateX(-' + (slideIdx * 100) + '%)';
          captionEl.textContent = CAPS[c.photos[slideIdx]];
          counterEl.textContent = slideIdx + 1;
          dotsEl.querySelectorAll('button').forEach(function (d, j) {
            d.style.opacity   = j === slideIdx ? '1' : '0.35';
            d.style.transform = j === slideIdx ? 'scale(1.35)' : 'scale(1)';
          });
        }

        function goToSlide (idx) {
          slideIdx = (idx + CASES[activeCase].photos.length) % CASES[activeCase].photos.length;
          updateCarousel();
        }

        function updateInfo (idx) {
          var c = CASES[idx];
          titleEl.textContent = c.title;
          badgeEl.textContent = c.badge;
          areaEl.textContent  = c.area;
          daysEl.textContent  = c.days;
          priceEl.textContent = c.price;
          descEl.textContent  = c.desc;
        }

        function updateSelectors (idx) {
          selectEl.querySelectorAll('button').forEach(function (btn, i) {
            if (i === idx) {
              btn.style.borderColor = '#C2410C';
              btn.style.boxShadow   = '0 4px 16px rgba(194,65,12,0.2)';
            } else {
              btn.style.borderColor = 'transparent';
              btn.style.boxShadow   = '0 2px 8px rgba(31,41,55,.04)';
            }
          });
        }

        function activateCase (idx) {
          if (idx === activeCase) return;
          if (timer) clearInterval(timer);
          if (!reduced) {
            infoEl.style.opacity   = '0';
            infoEl.style.transform = 'translateY(6px)';
          }
          activeCase = idx; slideIdx = 0;
          buildSlides(idx);
          updateCarousel();
          updateInfo(idx);
          updateSelectors(idx);
          if (!reduced) {
            setTimeout(function () {
              infoEl.style.opacity   = '1';
              infoEl.style.transform = 'translateY(0)';
            }, 40);
          }
          if (!reduced) timer = setInterval(function () { goToSlide(slideIdx + 1); }, 3500);
        }

        document.getElementById('case-prev').addEventListener('click', function () { goToSlide(slideIdx - 1); });
        document.getElementById('case-next').addEventListener('click', function () { goToSlide(slideIdx + 1); });

        // Init
        buildSlides(0);
        updateCarousel();
        updateInfo(0);
        updateSelectors(0);
        if (!reduced) timer = setInterval(function () { goToSlide(slideIdx + 1); }, 3500);
      })();
      </script>
    </section>

    <!-- ═══════════════════════════════════════════
         SECTION: PROCESS
    ════════════════════════════════════════════ -->
    <section id="process" class="py-20 lg:py-28" style="background: var(--color-bg);">
