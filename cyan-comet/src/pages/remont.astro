---
import '../styles/global.css';

const title = "Ремонт квартир под ключ в Москве — фиксированная смета и договор";
const description = "Ремонт квартир под ключ в Москве: капитальный, косметический и дизайнерский ремонт. Фиксированная смета, договор, график работ, гарантия.";
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        color-scheme: light;
        --color-ink: #1F2937;
        --color-ink-2: #111827;
        --color-accent: #C2410C;
        --color-accent-2: #9A3412;
        --color-bg: #FAFAF7;
        --color-soft: #F0EDE7;
        --color-card: #FFFFFF;
        --color-border: #E5E2DC;
        --color-muted: #6B6F76;
      }
      html {
        scroll-behavior: smooth;
        background: var(--color-bg);
      }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--color-ink);
        background: var(--color-bg);
        -webkit-font-smoothing: antialiased;
      }
      .font-display {
        font-family: 'Bricolage Grotesque', system-ui, sans-serif;
        letter-spacing: -0.02em;
      }
      .num {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum" 1;
      }
      .ring-inset-1 {
        box-shadow: inset 0 0 0 1px var(--color-border);
      }
      .shadow-card {
        box-shadow: 0 2px 8px rgba(31,41,55,.04), 0 1px 2px rgba(31,41,55,.04);
      }
      .shadow-lift {
        box-shadow: 0 8px 24px rgba(31,41,55,.08);
      }
      section[id] { scroll-margin-top: 88px; }
      @media (max-width: 1023px) {
        body { padding-bottom: 88px; }
      }
    </style>
  </head>
  <body>

    <!-- HEADER -->
    <header class="sticky top-0 z-40 backdrop-blur border-b" style="background: rgba(250,250,247,0.9); border-color: var(--color-border);">
      <div class="max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between">

        <a href="#" class="flex items-center gap-2.5">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg text-white" style="background: var(--color-ink);">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6"/>
            </svg>
          </span>
          <span class="font-display text-xl font-semibold">РемПрофи</span>
        </a>

        <nav class="hidden lg:flex items-center gap-7 text-sm" style="color: var(--color-muted);">
          <a href="#packages" class="hover:text-gray-900 transition-colors">Пакеты</a>
          <a href="#cases" class="hover:text-gray-900 transition-colors">Кейсы</a>
          <a href="#process" class="hover:text-gray-900 transition-colors">Этапы</a>
          <a href="#guarantee" class="hover:text-gray-900 transition-colors">Гарантия</a>
          <a href="#faq" class="hover:text-gray-900 transition-colors">Вопросы</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="tel:+74950000000" class="hidden md:inline text-sm font-semibold num">+7 495 000-00-00</a>
          <a
            href="#cta"
            class="inline-flex items-center h-10 md:h-11 px-4 md:px-5 rounded-xl text-white text-sm font-semibold transition-colors"
            style="background: var(--color-ink);"
            onmouseover="this.style.background='var(--color-ink-2)'"
            onmouseout="this.style.background='var(--color-ink)'"
          >
            Рассчитать смету
          </a>
        </div>

      </div>
    </header>

    <!-- HERO -->
    <section class="relative">
      <div class="max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8 pt-10 md:pt-16 pb-14 md:pb-20">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">

          <!-- Left column -->
          <div class="lg:col-span-6">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white ring-inset-1 text-xs font-medium" style="color: var(--color-muted);">
              <span class="w-1.5 h-1.5 rounded-full" style="background: var(--color-accent);"></span>
              Ремонт в Москве и области · принимаем заявки сегодня
            </div>

            <h1 class="font-display mt-6 text-[40px] leading-[1.05] sm:text-5xl lg:text-[64px] font-semibold" style="color: var(--color-ink);">
              Ремонт квартир<br/>
              под ключ<br class="hidden sm:block"/>
              <span style="color: var(--color-accent);">— по договору</span>,<br class="hidden sm:block"/>
              <span class="font-medium" style="color: var(--color-muted);">без сюрпризов в смете</span>
            </h1>

            <p class="mt-6 text-base md:text-lg leading-relaxed max-w-xl" style="color: var(--color-muted);">
              Капитальный, косметический и дизайнерский ремонт квартир в новостройках и на вторичке. Фиксируем смету и график в договоре, ведём один прораб на объекте. Стандартный срок ремонта двухкомнатной квартиры — 50–70 дней.
            </p>

            <ul class="mt-7 grid sm:grid-cols-2 gap-3 max-w-xl text-sm">
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 inline-flex w-5 h-5 rounded-md items-center justify-center shrink-0" style="background: rgba(194,65,12,0.1); color: var(--color-accent);">
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
                </span>
                Фиксированная смета — закрепляем в договоре
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 inline-flex w-5 h-5 rounded-md items-center justify-center shrink-0" style="background: rgba(194,65,12,0.1); color: var(--color-accent);">
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
                </span>
                График с контрольными точками
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 inline-flex w-5 h-5 rounded-md items-center justify-center shrink-0" style="background: rgba(194,65,12,0.1); color: var(--color-accent);">
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
                </span>
                Один прораб ведёт объект целиком
              </li>
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 inline-flex w-5 h-5 rounded-md items-center justify-center shrink-0" style="background: rgba(194,65,12,0.1); color: var(--color-accent);">
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M2 6.5l2.5 2.5L10 3.5"/></svg>
                </span>
                Гарантия на работы — 3 года
              </li>
            </ul>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="#cta"
                class="inline-flex items-center h-12 px-6 rounded-xl text-white font-semibold transition-colors"
                style="background: var(--color-ink);"
                onmouseover="this.style.background='var(--color-ink-2)'"
                onmouseout="this.style.background='var(--color-ink)'"
              >
                Рассчитать стоимость ремонта
              </a>
              <a
                href="#cases"
                class="inline-flex items-center h-12 px-1 font-semibold underline underline-offset-4 decoration-2"
                style="color: var(--color-ink); text-decoration-color: var(--color-accent);"
              >
                Посмотреть кейсы →
              </a>
            </div>

            <div class="mt-10 flex items-center gap-5">
              <div class="flex items-center gap-1 text-amber-500 text-sm">
                <span>★★★★★</span>
                <span class="font-semibold ml-1 num" style="color: var(--color-ink);">4.8</span>
              </div>
              <div class="text-sm" style="color: var(--color-muted);">600+ сданных квартир в Москве и МО</div>
            </div>
          </div>

          <!-- Right column -->
          <div class="lg:col-span-6">
            <div class="relative">
              <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-lift bg-gradient-to-br from-gray-800 to-gray-600">
                <img
                  src="/images/remont/hero-remont.jpg"
                  alt="Ремонт квартиры под ключ в Москве — готовая гостиная после ремонта"
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              </div>

              <!-- Floating form card -->
              <div class="mt-6 lg:mt-0 lg:absolute lg:-bottom-8 lg:-left-6 lg:w-[340px] bg-white rounded-2xl shadow-lift p-5 ring-inset-1">
                <div class="flex items-center justify-between mb-1">
                  <div class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-accent);">Бесплатно</div>
                  <div class="text-xs" style="color: var(--color-muted);">≈ 1 минута</div>
                </div>
                <h3 class="font-display text-lg font-semibold">Получить ориентировочную смету</h3>
                <form class="mt-4 space-y-2.5">
                  <input
                    type="text"
                    placeholder="Ваше имя"
                    class="w-full h-11 px-4 rounded-lg text-sm outline-none transition-colors border border-transparent focus:border-gray-900"
                    style="background: var(--color-soft);"
                  />
                  <input
                    type="tel"
                    placeholder="+7 (___) ___-__-__"
                    class="w-full h-11 px-4 rounded-lg text-sm num outline-none transition-colors border border-transparent focus:border-gray-900"
                    style="background: var(--color-soft);"
                  />
                  <input
                    type="number"
                    placeholder="Площадь, м² (опционально)"
                    class="w-full h-11 px-4 rounded-lg text-sm num outline-none transition-colors border border-transparent focus:border-gray-900"
                    style="background: var(--color-soft);"
                  />
                  <button
                    type="button"
                    class="w-full h-11 rounded-lg text-white font-semibold text-sm transition-colors"
                    style="background: var(--color-accent);"
                    onmouseover="this.style.background='var(--color-accent-2)'"
                    onmouseout="this.style.background='var(--color-accent)'"
                  >
                    Получить смету →
                  </button>
                  <p class="text-[11px] leading-relaxed" style="color: var(--color-muted);">
                    Нажимая кнопку, вы соглашаетесь с <a href="#" class="underline">политикой обработки персональных данных</a>.
                  </p>
                </form>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- TRUST BAR -->
    <section class="border-y" style="background: var(--color-soft); border-color: var(--color-border);">
      <div class="max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8 py-8 md:py-10">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-y-6 gap-x-4">

          <div>
            <div class="font-display text-3xl md:text-4xl font-semibold num">
              14<span style="color: var(--color-accent);">+</span>
            </div>
            <div class="text-xs mt-1" style="color: var(--color-muted);">лет на рынке ремонта в Москве</div>
          </div>

          <div>
            <div class="font-display text-3xl md:text-4xl font-semibold num">
              600<span style="color: var(--color-accent);">+</span>
            </div>
            <div class="text-xs mt-1" style="color: var(--color-muted);">сданных квартир под ключ</div>
          </div>

          <div>
            <div class="font-display text-3xl md:text-4xl font-semibold num">95 000</div>
            <div class="text-xs mt-1" style="color: var(--color-muted);">м² выполненного ремонта</div>
          </div>

          <div>
            <div class="font-display text-3xl md:text-4xl font-semibold num">8</div>
            <div class="text-xs mt-1" style="color: var(--color-muted);">штатных бригад, без субподряда</div>
          </div>

          <div class="col-span-2 md:col-span-1">
            <div class="font-display text-3xl md:text-4xl font-semibold num">4.8 ★</div>
            <div class="text-xs mt-1" style="color: var(--color-muted);">Яндекс, Авито Услуги, Профи.ру</div>
          </div>

        </div>
      </div>
    </section>

    <!-- PAIN POINTS -->
    <section class="py-16 md:py-24">
      <div class="max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8">

        <div class="max-w-2xl">
          <div class="text-xs font-semibold tracking-widest uppercase" style="color: var(--color-accent);">Знакомо?</div>
          <h2 class="font-display text-3xl md:text-5xl font-semibold mt-3 leading-tight">
            Почему ремонт квартир<br class="hidden md:block"/>
            часто превращается в проблему
          </h2>
        </div>

        <div class="mt-10 md:mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

          <!-- Card 1 -->
          <div class="p-6 rounded-2xl ring-inset-1 hover:shadow-card transition-shadow" style="background: var(--color-card);">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background: var(--color-soft);">
              <svg class="w-5 h-5" style="color: var(--color-ink);" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Сроки сорваны</h3>
            <p class="text-sm mt-1.5" style="color: var(--color-muted);">Обещали 3 месяца, идёт девятый. Прораб ушёл, бригада сменилась, никто не отвечает за просрочку.</p>
          </div>

          <!-- Card 2 -->
          <div class="p-6 rounded-2xl ring-inset-1 hover:shadow-card transition-shadow" style="background: var(--color-card);">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background: var(--color-soft);">
              <svg class="w-5 h-5" style="color: var(--color-ink);" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Цена выросла в полтора-два раза</h3>
            <p class="text-sm mt-1.5" style="color: var(--color-muted);">Изначальная смета — «приманка». По факту доплаты появляются на каждом этапе работ.</p>
          </div>

          <!-- Card 3 -->
          <div class="p-6 rounded-2xl ring-inset-1 hover:shadow-card transition-shadow" style="background: var(--color-card);">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background: var(--color-soft);">
              <svg class="w-5 h-5" style="color: var(--color-ink);" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Бригада исчезла</h3>
            <p class="text-sm mt-1.5" style="color: var(--color-muted);">Получили предоплату — и пропали. Объект брошен, по телефону никто не отвечает, договор «с физлицом».</p>
          </div>

          <!-- Card 4 -->
          <div class="p-6 rounded-2xl ring-inset-1 hover:shadow-card transition-shadow" style="background: var(--color-card);">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background: var(--color-soft);">
              <svg class="w-5 h-5" style="color: var(--color-ink);" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <path d="M12 9v4M12 17h.01"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Скрытый брак вылез через год</h3>
            <p class="text-sm mt-1.5" style="color: var(--color-muted);">Трещины на стенах, отошла плитка, течёт стояк. Гарантии нет — бригаду не найти.</p>
          </div>

          <!-- Card 5 -->
          <div class="p-6 rounded-2xl ring-inset-1 hover:shadow-card transition-shadow" style="background: var(--color-card);">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background: var(--color-soft);">
              <svg class="w-5 h-5" style="color: var(--color-ink);" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <circle cx="9" cy="7" r="4"/><circle cx="17" cy="7" r="3"/>
                <path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2M16 21v-2a4 4 0 0-3-3.87"/>
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Никто не главный на объекте</h3>
            <p class="text-sm mt-1.5" style="color: var(--color-muted);">Сантехники, электрики, отделочники — у каждых свой «координатор». Стрелки переводят друг на друга.</p>
          </div>

          <!-- CTA card -->
          <a href="#cta" class="p-6 rounded-2xl text-white relative overflow-hidden group" style="background: var(--color-ink);">
            <div class="absolute -right-8 -bottom-8 w-32 h-32 rounded-full blur-2xl" style="background: rgba(194,65,12,0.2);"></div>
            <h3 class="font-semibold text-lg">Узнаёте знакомую ситуацию?</h3>
            <p class="text-sm mt-1.5" style="color: rgba(255,255,255,0.7);">Мы строим работу так, чтобы вам не пришлось переживать ни одну из этих историй.</p>
            <span class="mt-4 inline-flex items-center text-sm font-semibold transition-colors" style="color: var(--color-accent);">
              Записаться на бесплатный замер →
            </span>
          </a>

        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════
         SECTION: PACKAGES / PRICING
    ════════════════════════════════════════════ -->
    <section id="packages" class="py-20 lg:py-28" style="background: var(--color-bg);">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Header -->
        <div class="text-center mb-12">
          <p class="text-sm font-semibold uppercase tracking-widest mb-3" style="color: var(--color-accent);">Цены на ремонт квартир в Москве</p>
          <h2 class="font-display text-3xl sm:text-4xl font-bold mb-4" style="color: var(--color-ink-2);">Три пакета ремонта под разные задачи</h2>
          <p class="max-w-2xl mx-auto text-base leading-relaxed" style="color: var(--color-muted);">Цены указаны за работы. Материалы, мебель и техника рассчитываются отдельно по ведомости. После замера фиксируем точную смету в договоре.</p>
        </div>

        <!-- Cards grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">

          <!-- Card 1: Косметический -->
          <div class="bg-white rounded-2xl p-7 shadow-card flex flex-col" style="border: 1px solid var(--color-border);">
            <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: var(--color-muted);">Косметический ремонт</p>
            <p class="font-display text-3xl font-bold mb-1" style="color: var(--color-ink-2);">от 9 500 ₽/м²</p>
            <p class="text-xs mb-6" style="color: var(--color-muted);">за работы</p>
            <ul class="space-y-2 flex-1 mb-6">
              <li class="flex gap-2 text-sm" style="color: var(--color-ink);">
                <span style="color: var(--color-accent);">✓</span> Замена обоев, покраска стен и потолков, замена напольных покрытий
              </li>
              <li class="flex gap-2 text-sm" style="color: var(--color-ink);">
                <span style="color: var(--color-accent);">✓</span> Без штробления и переноса коммуникаций
              </li>
            </ul>
            <p class="text-sm font-medium mt-auto pt-4" style="border-top: 1px solid var(--color-border); color: var(--color-muted);">Срок: от 30 дней</p>
          </div>

          <!-- Card 2: Капитальный (FEATURED) -->
          <div class="rounded-2xl p-7 flex flex-col relative" style="background: var(--color-ink-2); border: 2px solid var(--color-accent); box-shadow: 0 8px 32px rgba(194,65,12,0.25);">
            <!-- Badge -->
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-xs font-bold uppercase tracking-widest px-4 py-1 rounded-full text-white" style="background: var(--color-accent);">Хит</span>
            <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: rgba(255,255,255,0.55);">Капитальный ремонт под ключ</p>
            <p class="font-display text-3xl font-bold mb-1 text-white">от 18 000 ₽/м²</p>
            <p class="text-xs mb-6" style="color: rgba(255,255,255,0.45);">за работы</p>
