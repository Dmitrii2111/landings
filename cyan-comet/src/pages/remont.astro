      <script is:inline>
      (function () {
        var PKGS = {
          cosmetic:  { works: 14000, mats: 12000, design: 0,    min: 650000  },
          capital:   { works: 26000, mats: 24000, design: 0,    min: 1250000 },
          designer:  { works: 42000, mats: 38000, design: 5000, min: 2400000 },
        };
        var CONDS = {
          new_raw:             1.00,
          new_finish:          0.82,
          secondary_living:    1.18,
          secondary_demolition:1.28,
          commercial:          1.12,
        };

        function r10k(n) { return Math.round(n / 10000) * 10000; }
        function formatRubFull(n) {
          return r10k(n).toLocaleString('ru-RU') + ' ₽';
        }
        function formatRubCompact(n) {
          var v = r10k(n);
          if (v < 1000000) return v.toLocaleString('ru-RU') + ' ₽';
          if (v < 10000000) return (v / 1000000).toFixed(2).replace('.', ',') + ' млн ₽';
          return (v / 1000000).toFixed(1).replace('.', ',') + ' млн ₽';
        }
        function formatRubRangeCompact(low, high) {
          var lo = r10k(low), hi = r10k(high);
          var loM = lo >= 1000000, hiM = hi >= 1000000;
          if (loM && hiM) {
            var dec = function(v) { return v < 10000000 ? (v/1e6).toFixed(2) : (v/1e6).toFixed(1); };
            return dec(lo).replace('.', ',') + '–' + dec(hi).replace('.', ',') + ' млн ₽';
          }
          if (!loM && hiM) return lo.toLocaleString('ru-RU') + ' ₽–' + formatRubCompact(hi);
          return lo.toLocaleString('ru-RU') + '–' + hi.toLocaleString('ru-RU') + ' ₽';
        }

        function calc() {
          var pkg   = document.getElementById('calc-package').value;
          var cond  = document.getElementById('calc-condition').value;
          var area  = Math.min(250, Math.max(20, parseFloat(document.getElementById('calc-area').value) || 60));
          var hasDp = document.getElementById('calc-design-project').checked;
          var hasFu = document.getElementById('calc-furniture').checked;

          var p     = PKGS[pkg];
          var coef  = CONDS[cond];

          var designRate    = p.design + (hasDp && pkg !== 'designer' ? 5000 : 0);
          var furnitureRate = hasFu ? 18000 : 0;
          var baseRate      = p.works + p.mats + designRate + furnitureRate;

          var rawTotal = area * baseRate * coef;
          var total    = r10k(Math.max(rawTotal, p.min));
          var low      = r10k(total * 0.88);
          var high     = r10k(total * 1.12);

          var worksAmt = r10k(area * p.works * coef);
          var matsAmt  = r10k(area * p.mats  * coef);
          var dpAmt    = designRate    > 0 ? r10k(area * designRate    * coef) : 0;
          var fuAmt    = furnitureRate > 0 ? r10k(area * furnitureRate * coef) : 0;

          document.getElementById('calc-range').textContent   = formatRubRangeCompact(low, high);
          document.getElementById('calc-mid').textContent     = 'Средний ориентир: ' + formatRubFull(total);
          document.getElementById('calc-works').textContent   = formatRubFull(worksAmt);
          document.getElementById('calc-materials').textContent = formatRubFull(matsAmt);

          var dpRow = document.getElementById('calc-design-row');
          dpRow.style.cssText = designRate > 0 ? '' : 'display:none !important;';
          if (designRate > 0) document.getElementById('calc-design-cost').textContent = formatRubFull(dpAmt);

          var fuRow = document.getElementById('calc-furniture-row');
          fuRow.style.cssText = hasFu ? '' : 'display:none !important;';
          if (hasFu) document.getElementById('calc-furniture-cost').textContent = formatRubFull(fuAmt);
        }

        ['calc-package','calc-condition','calc-area','calc-design-project','calc-furniture'].forEach(function(id){
          var el = document.getElementById(id);
          if (el) el.addEventListener('change', calc);
        });

        calc();
      })();
      </script>
