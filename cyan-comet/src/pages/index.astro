---
import '../styles/global.css';

const projects = [
  {
    name: 'Стоматология / Имплантация зубов',
    niche: 'Медицина',
    nicheBg: 'bg-teal-100',
    nicheText: 'text-teal-700',
    description: 'Лендинг стоматологической клиники с акцентом на услугу имплантации зубов.',
    slug: '/dental',
    linkColor: 'text-teal-600 hover:text-teal-800',
  },
  {
    name: 'Ремонт квартир под ключ',
    niche: 'Строительство',
    nicheBg: 'bg-orange-100',
    nicheText: 'text-orange-700',
    description: 'Лендинг строительной компании с портфолио объектов и расчётом стоимости.',
    slug: '/remont',
    linkColor: 'text-orange-600 hover:text-orange-800',
  },
  {
    name: 'Аренда спецтехники',
    niche: 'Техника',
    nicheBg: 'bg-amber-100',
    nicheText: 'text-amber-700',
    description: 'Лендинг компании по аренде строительной и дорожной спецтехники.',
    slug: '/equipment',
    linkColor: 'text-amber-600 hover:text-amber-800',
  },
  {
    name: 'Банкротство физических лиц',
    niche: 'Юридические услуги',
    nicheBg: 'bg-indigo-100',
    nicheText: 'text-indigo-700',
    description: 'Лендинг юридической компании по сопровождению процедуры банкротства граждан.',
    slug: '/bankruptcy',
    linkColor: 'text-indigo-600 hover:text-indigo-800',
  },
  {
    name: 'Курсы английского языка',
    niche: 'Образование',
    nicheBg: 'bg-violet-100',
    nicheText: 'text-violet-700',
    description: 'Лендинг языковой школы с описанием программ и форматов обучения.',
    slug: '/english',
    linkColor: 'text-violet-600 hover:text-violet-800',
  },
];

const workflow = [
  {
    title: 'HTML Prototypes',
    body: 'Эталонные прототипы хранятся в templates/. Их не редактируем.',
  },
  {
    title: 'Astro Pages',
    body: 'Каждый лендинг переносится в cyan-comet/src/pages/ отдельной задачей.',
  },
  {
    title: 'По секциям',
    body: 'Перенос выполняется секциями, не целыми файлами.',
  },
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Commercial Landings — Портфолио коммерческих лендингов</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F6F7FB] text-gray-900 min-h-screen font-[Inter,system-ui,sans-serif]">

    <!-- Header -->
    <header class="border-b border-gray-200 bg-white/80 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center gap-3">
        <span class="text-base font-semibold tracking-tight">Commercial Landings</span>
        <span class="text-gray-400 hidden sm:inline">·</span>
        <span class="text-sm text-gray-500 hidden sm:inline">Портфолио коммерческих лендингов</span>
        <span class="ml-auto text-xs font-medium bg-blue-600 text-white px-3 py-1 rounded-full">5 HTML prototypes</span>
      </div>
    </header>

    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-5 leading-tight">
        Портфолио коммерческих лендингов
      </h1>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto mb-10">
        Пять HTML-прототипов для разных ниш: медицина, ремонт, спецтехника, юридические услуги и образование.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-3 rounded-xl transition-colors"
        >
          Смотреть проекты
        </a>
        <a
          href="#"
          class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 text-sm font-semibold px-6 py-3 rounded-xl transition-colors"
        >
          Открыть templates
        </a>
      </div>
    </section>

    <!-- Cards grid -->
    <section id="projects" class="max-w-6xl mx-auto px-6 pb-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <article class="bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col">
            <div class="flex items-center gap-2 mb-4">
              <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${project.nicheBg} ${project.nicheText}`}>
                {project.niche}
              </span>
              <span class="text-xs font-medium bg-green-50 text-green-700 border border-green-200 px-2.5 py-1 rounded-full ml-auto">
                HTML prototype ready
              </span>
            </div>
            <h2 class="text-base font-semibold leading-snug mb-2">{project.name}</h2>
            <p class="text-sm text-gray-500 leading-relaxed mb-6 flex-1">{project.description}</p>
            <a
              href={project.slug}
              class={`text-sm font-medium ${project.linkColor} transition-colors`}
            >
              Открыть страницу &rarr;
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- Workflow section -->
    <section class="bg-white border-t border-gray-200">
      <div class="max-w-6xl mx-auto px-6 py-16">
        <h2 class="text-2xl font-bold tracking-tight mb-10 text-center">Как устроен проект</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          {workflow.map((item) => (
            <div class="flex flex-col gap-2">
              <h3 class="text-sm font-semibold text-blue-600 uppercase tracking-wide">{item.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-200 bg-[#F6F7FB]">
      <div class="max-w-6xl mx-auto px-6 py-6 text-center text-sm text-gray-400">
        &copy; 2026 Commercial Landings &middot; Astro + Tailwind CSS
      </div>
    </footer>

  </body>
</html>
