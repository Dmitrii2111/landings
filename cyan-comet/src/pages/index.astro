---
import '../styles/global.css';
import projectsData from '../data/landingProjects.json';

const projects = projectsData.projects;
const publishedProjects = projects.filter((p) => p.status !== "wip" && !p.isDisabled);

const statusStyle: Record<string, string> = {
  ready: 'bg-emerald-50 text-emerald-700 border border-emerald-200',
  wip: 'bg-amber-50 text-amber-700 border border-amber-200',
};

const nicheStyle: Record<string, string> = {
  medicina: 'bg-teal-50 text-teal-700',
  stroitelstvo: 'bg-orange-50 text-orange-700',
  tehnika: 'bg-amber-50 text-amber-700',
  yuridicheskie: 'bg-indigo-50 text-indigo-700',
  obrazovanie: 'bg-violet-50 text-violet-700',
};

// Build filters dynamically from data, preserving order of first appearance
const seenCategories = new Map<string, string>();
for (const p of projects) {
  if (!seenCategories.has(p.category)) {
    seenCategories.set(p.category, p.categoryLabel);
  }
}
const filters = [
  { key: 'all', label: 'Все' },
  ...Array.from(seenCategories.entries()).map(([key, label]) => ({ key, label })),
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Commercial Landings — Портфолио коммерческих лендингов</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F6F7FB] text-gray-900 min-h-screen font-[Inter,system-ui,sans-serif]">

    <!-- Header -->
    <header class="border-b border-gray-200 bg-white/80 backdrop-blur-sm sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center gap-3">
        <span class="text-base font-semibold tracking-tight">Commercial Landings</span>
        <span class="text-gray-400 hidden sm:inline">·</span>
        <span class="text-sm text-gray-500 hidden sm:inline">Портфолио коммерческих лендингов</span>
        <a href="https://t.me/dmhmsk" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-700">Telegram</a>
        <span class="ml-auto text-xs font-medium bg-blue-600 text-white px-3 py-1 rounded-full">{publishedProjects.length} примеров</span>
      </div>
    </header>

    <!-- Hero -->
    <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 text-center">
      <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 border border-blue-100 text-xs font-medium px-3 py-1.5 rounded-full mb-6">
        Astro + Tailwind CSS
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-5 leading-tight">
        Коммерческие лендинги<br class="hidden sm:block" /> для разных ниш
      </h1>
      <p class="text-lg text-gray-500 max-w-xl mx-auto mb-10">
        Готовые примеры для медицины, ремонта, спецтехники и образования. Отдельно показан CMS-демо для редактирования контента.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-3 rounded-xl transition-colors"
        >
          Смотреть проекты
        </a>
        <a
          href="https://t.me/dmhmsk"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 text-sm font-semibold px-6 py-3 rounded-xl transition-colors"
        >
          Написать в Telegram
        </a>
      </div>
    </section>

    <!-- Filters -->
    <section id="projects" class="max-w-6xl mx-auto px-6 pb-8">
      <div id="portfolio-filters" class="flex flex-wrap gap-2">
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            class={`pf-btn text-sm font-medium px-4 py-2 rounded-full border transition-colors ${i === 0 ? 'pf-active bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-400 hover:text-gray-900'}`}
          >
            {f.label}
          </button>
        ))}
      </div>
    </section>

    <!-- Cards grid -->
    <section class="max-w-6xl mx-auto px-6 pb-24">
      <div id="portfolio-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <article
            data-niche={project.category}
            class={`portfolio-card bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex flex-col overflow-hidden${project.isDisabled ? ' opacity-70' : ''}`}
          >
            <!-- Preview area -->
            {project.previewType === 'iframe' ? (
              <div class="pf-iframe-wrap">
                <iframe
                  src={project.previewUrl}
                  title={project.title}
                  loading="lazy"
                  scrolling="no"
                  tabindex="-1"
                  aria-hidden="true"
                ></iframe>
              </div>
            ) : (
              <div class="pf-mock-wrap">
                <div class="pf-mock-header">
                  <div class="pf-mock-logo"></div>
                  <div class="pf-mock-nav">
                    <div></div><div></div><div></div>
                  </div>
                </div>
                <div class="pf-mock-hero">
                  <div class="pf-mock-h1"></div>
                  <div class="pf-mock-h2"></div>
                  <div class="pf-mock-h3"></div>
                  <div class="pf-mock-btn-row">
                    <div class="pf-mock-cta"></div>
                    <div class="pf-mock-cta-ghost"></div>
                  </div>
                </div>
                <div class="pf-mock-cards-row">
                  <div class="pf-mock-card"></div>
                  <div class="pf-mock-card"></div>
                  <div class="pf-mock-card"></div>
                </div>
                <div class="pf-mock-badge">{project.statusLabel}</div>
              </div>
            )}

            <!-- Card body -->
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-2 mb-3 flex-wrap">
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${nicheStyle[project.category] ?? 'bg-gray-100 text-gray-600'}`}>
                  {project.categoryLabel}
                </span>
                <span class={`text-xs font-medium px-2.5 py-1 rounded-full ml-auto ${statusStyle[project.status] ?? 'bg-gray-100 text-gray-600 border border-gray-200'}`}>
                  {project.statusLabel}
                </span>
              </div>
              <h2 class="text-base font-semibold leading-snug mb-2">{project.title}</h2>
              <p class="text-sm text-gray-500 leading-relaxed mb-5 flex-1">{project.description}</p>
              {project.url ? (
                <a
                  href={project.url}
                  class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors"
                >
                  Открыть страницу &rarr;
                </a>
              ) : (
                <span class="text-sm font-medium text-gray-400 cursor-default">
                  Страница в разработке
                </span>
              )}
            </div>
          </article>
        ))}
      </div>

      <!-- Empty state -->
      <p id="portfolio-empty" class="hidden text-center text-gray-400 text-sm py-16">
        Нет проектов в этой нише
      </p>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-200 bg-white">
      <div class="max-w-6xl mx-auto px-6 py-10 text-center">
        <p class="text-base font-semibold text-gray-800 mb-1">Commercial Landings</p>
        <p class="text-sm text-gray-400">&copy; 2026 &middot; Astro + Tailwind CSS &middot; 4 готовых лендинга · CMS-демо · 1 пример в переносе</p>
        <a href="https://t.me/dmhmsk" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline text-sm">Обсудить лендинг: @dmhmsk</a>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Niche filter
        var filtersEl = document.getElementById('portfolio-filters');
        var cards = document.querySelectorAll('.portfolio-card');
        var emptyEl = document.getElementById('portfolio-empty');

        if (filtersEl) {
          filtersEl.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-filter]');
            if (!btn) return;

            filtersEl.querySelectorAll('[data-filter]').forEach(function (b) {
              b.classList.remove('pf-active', 'bg-gray-900', 'text-white', 'border-gray-900');
              b.classList.add('bg-white', 'text-gray-600', 'border-gray-200');
            });
            btn.classList.add('pf-active', 'bg-gray-900', 'text-white', 'border-gray-900');
            btn.classList.remove('bg-white', 'text-gray-600', 'border-gray-200');

            var key = btn.getAttribute('data-filter');
            var visible = 0;
            cards.forEach(function (card) {
              var match = key === 'all' || card.getAttribute('data-niche') === key;
              card.style.display = match ? '' : 'none';
              if (match) visible++;
            });

            if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
          });
        }

        // iframe scale: fit iframe width to wrapper width
        function scaleIframes() {
          document.querySelectorAll('.pf-iframe-wrap').forEach(function (wrap) {
            var iframe = wrap.querySelector('iframe');
            if (!iframe) return;
            var scale = wrap.offsetWidth / 1280;
            iframe.style.transform = 'scale(' + scale + ')';
          });
        }
        scaleIframes();
        window.addEventListener('resize', scaleIframes);
      })();
    </script>

  </body>
</html>
