---
import '../styles/global.css';
const title = "Аренда спецтехники в Москве и МО — экскаваторы, манипуляторы, автокраны";
const description = "Аренда спецтехники с оператором в Москве и Московской области: экскаваторы, манипуляторы, автокраны, самосвалы и погрузчики. Подача от 2 часов, фиксированная ставка, расчёт за 15 минут.";
---

<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0C1220" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --c-dark:    #0C1220;
      --c-panel:   #1A2436;
      --c-line:    #2A3548;
      --c-amber:   #F59E0B;
      --c-amber2:  #D97706;
      --c-bg:      #F7F8FA;
      --c-soft:    #EEF1F5;
      --c-ink:     #1E293B;
      --c-ink2:    #0F172A;
      --c-muted:   #64748B;
      --c-border:  #E2E8F0;
      --c-success: #16A34A;
      --c-card:    #FFFFFF;
    }
    html { scroll-behavior: smooth; background: var(--c-bg); }
    body { font-family: 'Inter', system-ui, sans-serif; color: var(--c-ink); background: var(--c-bg); -webkit-font-smoothing: antialiased; margin: 0; }
    .display { font-family: 'Manrope', system-ui, sans-serif; letter-spacing: -0.035em; }
    .mono    { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
    section[id] { scroll-margin-top: 80px; }
    @media (max-width: 1023px) { body { padding-bottom: 76px; } }

    /* grid lines overlay */
    .grid-lines {
      background-image:
        linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    /* image placeholder */
    .ph {
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at 70% 20%, rgba(245,158,11,.18), transparent 42%),
                  linear-gradient(135deg, #182235, #334155);
    }
    .ph::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
    }
    .ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
    .ph .img-show { opacity: 1; }
    .ph-label {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 18px;
      text-align: center;
      color: rgba(255,255,255,.78);
      font-size: 11px;
      line-height: 1.45;
      font-family: 'JetBrains Mono', monospace;
    }
    .ph-label .mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border: 1px solid rgba(245,158,11,.45);
      background: rgba(245,158,11,.14);
      color: var(--c-amber);
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 13px;
    }

    /* catalog grid cell */
    .tech-cell {
      border-right: 1px solid var(--c-border);
      border-bottom: 1px solid var(--c-border);
    }

    /* documents */
    .doc-paper {
      aspect-ratio: 3 / 4;
      background: #fff;
      border: 1px solid var(--c-border);
      position: relative;
      overflow: hidden;
    }
    .doc-line { height: 4px; background: #CBD5E1; border-radius: 99px; opacity: .75; }
    .stamp {
      border: 1px solid rgba(245,158,11,.75);
      color: var(--c-amber2);
      border-radius: 999px;
      width: 54px; height: 54px;
      display: flex; align-items: center; justify-content: center;
      text-align: center;
      font-size: 9px; line-height: 1.05;
      transform: rotate(-12deg);
    }

    /* faq */
    .equipment-faq-item {
      background: #fff;
      border: 1px solid var(--c-border);
      transition: border-color 220ms ease;
    }
    .equipment-faq-item.is-open {
      border-color: var(--c-amber2);
    }
    .equipment-faq-trigger {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      background: transparent;
      border: 0;
      cursor: pointer;
      font-weight: 700;
      color: var(--c-ink2);
      text-align: left;
    }
    .equipment-faq-trigger:focus-visible {
      outline: 2px solid rgba(245, 158, 11, 0.7);
      outline-offset: 4px;
    }
    .equipment-faq-panel {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 280ms ease, opacity 220ms ease;
      will-change: max-height;
    }
    .equipment-faq-item.is-open .equipment-faq-panel {
      opacity: 1;
    }
    .equipment-faq-answer {
      padding-top: 12px;
      color: var(--c-muted);
      font-size: 0.875rem;
    }
    .equipment-faq-icon {
      position: relative;
      width: 28px;
      height: 28px;
      color: var(--c-amber2);
      flex-shrink: 0;
    }
    .equipment-faq-icon span {
      position: absolute;
      background: currentColor;
      width: 24px;
      height: 2px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      transition: transform 220ms ease;
    }
    .equipment-faq-icon span:last-child {
      transform: translate(-50%, -50%) rotate(90deg);
    }
    .equipment-faq-item.is-open .equipment-faq-icon span:last-child {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    @media (prefers-reduced-motion: reduce) {
      .equipment-faq-panel,
      .equipment-faq-icon span {
        transition: none;
      }
    }
  </style>
</head>
<body>

<!-- ══════════ HEADER ══════════ -->
<header class="sticky top-0 z-40 backdrop-blur" style="background: rgba(12,18,32,.96); border-bottom: 1px solid var(--c-line);">
  <div class="max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8 flex items-center justify-between" style="height: 64px;">

    <a href="#" class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center w-10 h-10" style="background: var(--c-amber);">
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="#0C1220" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 18h18M5 18v-4l3-6h6l3 4v6"/><circle cx="7" cy="19" r="2"/><circle cx="17" cy="19" r="2"/>
        </svg>
      </span>
      <span class="display text-xl font-extrabold text-white">ТехПарк <span style="color: var(--c-amber);">24</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-sm" style="color: rgba(255,255,255,.6);">
      <a href="#catalog"   class="hover:text-white transition-colors">Каталог</a>
      <a href="#tariffs"   class="hover:text-white transition-colors">Тарифы</a>
      <a href="#why"       class="hover:text-white transition-colors">Гарантии</a>
      <a href="#area"      class="hover:text-white transition-colors">Зоны работы</a>
      <a href="#docs"      class="hover:text-white transition-colors">Документы</a>
      <a href="#faq"       class="hover:text-white transition-colors">Вопросы</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="tel:+74950000024" class="hidden md:inline mono text-sm font-bold text-white">+7 495 000-00-24</a>
      <a href="#cta" class="inline-flex items-center px-5 mono text-sm font-extrabold transition-colors" style="height: 42px; background: var(--c-amber); color: var(--c-dark);">
        ЗАКАЗАТЬ
      </a>
    </div>

  </div>
</header>

<!-- ══════════ HERO ══════════ -->
<section class="relative overflow-hidden" style="background: var(--c-dark); color: #fff;">

  <!-- Gradient overlay -->
  <div class="absolute inset-0" style="background: linear-gradient(to right, #0C1220 0%, rgba(12,18,32,.9) 55%, rgba(12,18,32,.45) 100%); z-index: 1;"></div>
  <!-- Grid lines -->
  <div class="grid-lines absolute inset-0" style="opacity: .65; z-index: 1;"></div>
  <!-- Hero photo placeholder -->
  <div class="ph absolute inset-0" style="z-index: 0;">
    <img src="/images/equipment/hero-equipment.jpg" alt="Аренда спецтехники в Москве — техника на стройплощадке" loading="eager" class="img-show" />
  </div>

  <div class="relative max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8 pt-12 md:pt-20 pb-0" style="z-index: 2;">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-start" style="min-height: 680px;">

      <!-- Left: content -->
      <div class="lg:col-span-7 pt-4 pb-10">
        <div class="inline-flex items-center gap-2 px-3 py-2 mono text-xs font-bold uppercase tracking-wider" style="border: 1px solid rgba(245,158,11,.45); background: rgba(245,158,11,.1); color: var(--c-amber);">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--c-amber);"></span>
          Москва и МО · диспетчерская 24/7
        </div>

        <h1 class="display mt-7 font-extrabold leading-none" style="font-size: clamp(2.4rem, 6vw, 4.75rem);">
          Аренда спецтехники<br/>
          <span style="color: var(--c-amber);">с оператором</span><br/>
          в Москве и МО
        </h1>

        <p class="mt-6 text-base md:text-lg leading-relaxed max-w-2xl" style="color: rgba(255,255,255,.68);">
          Экскаваторы, манипуляторы, автокраны, самосвалы и погрузчики для стройки, демонтажа и земляных работ. Подача от 2 часов после заявки. Фиксированная ставка в договоре.
        </p>

        <div class="mt-8 grid sm:grid-cols-2 gap-3 max-w-2xl text-sm">
          {[
            ["01", "Подача техники на объект от 2 часов"],
            ["02", "Фиксированная ставка — никаких доплат"],
            ["03", "Осмотр машины перед каждым выездом"],
            ["04", "Замена техники при поломке за 4 часа"],
          ].map(([n, text]) => (
            <div class="flex gap-3 p-3" style="border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.05);">
              <span class="mono shrink-0" style="color: var(--c-amber);">{n}</span>
              <span style="color: rgba(255,255,255,.85);">{text}</span>
            </div>
          ))}
        </div>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="#cta" class="inline-flex items-center mono text-sm font-extrabold transition-colors" style="height: 50px; padding: 0 28px; background: var(--c-amber); color: var(--c-dark);">
            ЗАКАЗАТЬ ТЕХНИКУ →
          </a>
          <a href="#catalog" class="inline-flex items-center mono text-sm font-bold text-white" style="height: 50px; text-decoration: underline; text-decoration-color: var(--c-amber); text-underline-offset: 4px; text-decoration-thickness: 2px;">
            СМОТРЕТЬ КАТАЛОГ
          </a>
        </div>
      </div>

      <!-- Right: dispatcher panel -->
      <div class="lg:col-span-5 lg:pt-12 pb-10">
        <div class="p-5 md:p-6 shadow-xl" style="border: 1px solid rgba(245,158,11,.6); background: rgba(26,36,54,.94);">
          <div class="flex items-start justify-between pb-4" style="border-bottom: 1px solid rgba(255,255,255,.1);">
            <div>
              <div class="mono text-xs font-bold uppercase" style="color: var(--c-amber);">Диспетчерская</div>
              <h3 class="display text-2xl font-extrabold mt-1 text-white">Заявка в работу</h3>
            </div>
            <div class="mono text-xs" style="color: rgba(255,255,255,.4);">REQ-NEW</div>
          </div>

          <form class="mt-5 flex flex-col gap-3">
            <label>
              <span class="mono text-xs uppercase block mb-1" style="color: rgba(255,255,255,.4);">Тип техники</span>
              <select class="w-full h-12 px-3 mono text-sm text-white" style="background: var(--c-dark); border: 1px solid var(--c-line); outline: none;">
                <option>Экскаватор</option>
                <option>Манипулятор</option>
                <option>Автокран</option>
                <option>Самосвал</option>
                <option>Фронтальный погрузчик</option>
                <option>Мини-экскаватор</option>
                <option>Автовышка</option>
              </select>
            </label>
            <label>
              <span class="mono text-xs uppercase block mb-1" style="color: rgba(255,255,255,.4);">Срок аренды</span>
              <select class="w-full h-12 px-3 mono text-sm text-white" style="background: var(--c-dark); border: 1px solid var(--c-line); outline: none;">
                <option>Смена — 8 часов</option>
                <option>4 часа</option>
                <option>Сутки</option>
                <option>Неделя</option>
                <option>Месяц</option>
              </select>
            </label>
            <label>
              <span class="mono text-xs uppercase block mb-1" style="color: rgba(255,255,255,.4);">Телефон</span>
              <input type="tel" placeholder="+7 (___) ___-__-__" class="w-full h-12 px-3 mono text-sm text-white" style="background: var(--c-dark); border: 1px solid var(--c-line); outline: none;" />
            </label>
            <button type="button" class="w-full h-12 mono text-sm font-extrabold transition-colors" style="background: var(--c-amber); color: var(--c-dark);">
              ПОЛУЧИТЬ РАСЧЁТ ЗА 15 МИН →
            </button>
            <p class="text-xs leading-relaxed" style="color: rgba(255,255,255,.38);">
              Нажимая кнопку, вы соглашаетесь с политикой обработки персональных данных.
            </p>
          </form>

          <div class="mt-5 pt-4 flex items-center justify-between mono text-xs" style="border-top: 1px solid rgba(255,255,255,.1);">
            <span style="color: rgba(255,255,255,.5);">
              <span class="inline-block w-2 h-2 rounded-full mr-1.5 animate-pulse" style="background: var(--c-success);"></span>
              На линии: 2 диспетчера
            </span>
            <span style="color: var(--c-amber);">Ответ: 15 мин</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Status ticker -->
    <div style="border-top: 1px solid var(--c-line); border-bottom: 1px solid var(--c-line); background: rgba(12,18,32,.8);">
      <div class="grid md:grid-cols-4 mono text-xs divide-y md:divide-y-0 md:divide-x" style="color: rgba(255,255,255,.65); --tw-divide-color: var(--c-line);">
        <div class="p-3"><span style="color: var(--c-amber);">EX-01</span> · ЭКСКАВАТОР · ЦАО · СМЕНА · В РАБОТЕ</div>
        <div class="p-3"><span style="color: var(--c-amber);">MA-03</span> · МАНИПУЛЯТОР · ХИМКИ · 4 ЧАСА · ПОДАЧА</div>
        <div class="p-3"><span style="color: var(--c-amber);">CR-05</span> · АВТОКРАН · ПОДОЛЬСК · 2 СМЕНЫ · ПОДТВЕРЖДЕНО</div>
        <div class="p-3"><span style="color: var(--c-amber);">DU-06</span> · САМОСВАЛ · БАЛАШИХА · СМЕНА</div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════ OPERATIONAL PANEL ══════════ -->
<section style="background: var(--c-dark); color: #fff; border-top: 1px solid var(--c-line);">
  <div class="max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8 py-6">
    <div class="grid grid-cols-2 lg:grid-cols-6" style="border: 1px solid var(--c-line);">

      <div class="p-5" style="border-right: 1px solid var(--c-line);">
        <div class="mono text-xs font-bold uppercase" style="color: var(--c-amber);">LIVE / YEARS</div>
        <div class="display mono text-4xl font-extrabold mt-2">09</div>
        <div class="text-xs mt-1" style="color: rgba(255,255,255,.5);">лет на рынке</div>
      </div>

      <div class="p-5" style="border-right: 1px solid var(--c-line);">
        <div class="mono text-xs font-bold uppercase" style="color: var(--c-amber);">FLEET</div>
        <div class="display mono text-4xl font-extrabold mt-2">80+</div>
        <div class="text-xs mt-1" style="color: rgba(255,255,255,.5);">единиц техники</div>
      </div>

      <div class="p-5" style="border-right: 1px solid var(--c-line);">
        <div class="mono text-xs font-bold uppercase" style="color: var(--c-amber);">MONTH</div>
        <div class="display mono text-4xl font-extrabold mt-2">1200+</div>
        <div class="text-xs mt-1" style="color: rgba(255,255,255,.5);">выездов в месяц</div>
      </div>

      <div class="p-5" style="border-right: 1px solid var(--c-line);">
        <div class="mono text-xs font-bold uppercase" style="color: var(--c-amber);">OPS</div>
        <div class="display mono text-4xl font-extrabold mt-2">45</div>
        <div class="text-xs mt-1" style="color: rgba(255,255,255,.5);">операторов</div>
      </div>

      <div class="p-5" style="border-right: 1px solid var(--c-line);">
        <div class="mono text-xs font-bold uppercase" style="color: var(--c-amber);">RATE</div>
        <div class="display mono text-4xl font-extrabold mt-2">4.8★</div>
        <div class="text-xs mt-1" style="color: rgba(255,255,255,.5);">отзывы клиентов</div>
      </div>

      <div class="p-5 col-span-2 lg:col-span-1">
        <div class="mono text-xs font-bold uppercase" style="color: var(--c-amber);">LOAD</div>
        <div class="mt-3 h-2" style="background: rgba(255,255,255,.1);">
          <div class="h-full" style="width: 67%; background: var(--c-amber);"></div>
        </div>
        <div class="mono text-xs mt-3" style="color: rgba(255,255,255,.55);">Загрузка парка: 67%</div>
      </div>

    </div>
  </div>
</section>

<!-- ══════════ CATALOG ══════════ -->
<section id="catalog" class="py-14 md:py-20" style="background: var(--c-bg);">
  <div class="max-w-screen-xl mx-auto px-4 md:px-6 lg:px-8">

    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
      <div>
        <div class="mono text-xs font-bold uppercase tracking-widest" style="color: var(--c-amber2);">Парк техники</div>
        <h2 class="display text-3xl md:text-5xl font-extrabold mt-3" style="color: var(--c-ink2);">Аренда строительной техники: 8 категорий</h2>
        <p class="mt-4 max-w-2xl" style="color: var(--c-muted);">
          Своя техника — более 80 единиц в парке. Все машины проходят осмотр перед выездом, операторы со стажем от 5 лет. Подача по Москве и МО.
        </p>
      </div>
      <div id="catalog-filters" class="flex flex-wrap gap-2 mono text-xs shrink-0">
        <button type="button" data-filter="all"      aria-pressed="true"  class="catalog-filter px-3 py-2 font-bold" style="background: var(--c-ink); color: #fff;">ВСЕ</button>
        <button type="button" data-filter="earth"    aria-pressed="false" class="catalog-filter px-3 py-2" style="border: 1px solid var(--c-border); background: var(--c-card); color: var(--c-ink);">ЗЕМЛЯНЫЕ</button>
        <button type="button" data-filter="lifting"  aria-pressed="false" class="catalog-filter px-3 py-2" style="border: 1px solid var(--c-border); background: var(--c-card); color: var(--c-ink);">МОНТАЖ</button>
        <button type="button" data-filter="loading"  aria-pressed="false" class="catalog-filter px-3 py-2" style="border: 1px solid var(--c-border); background: var(--c-card); color: var(--c-ink);">ПОГРУЗКА</button>
        <button type="button" data-filter="transport" aria-pressed="false" class="catalog-filter px-3 py-2" style="border: 1px solid var(--c-border); background: var(--c-card); color: var(--c-ink);">ПЕРЕВОЗКА</button>
        <button type="button" data-filter="height"   aria-pressed="false" class="catalog-filter px-3 py-2" style="border: 1px solid var(--c-border); background: var(--c-card); color: var(--c-ink);">ВЫСОТНЫЕ</button>
      </div>
    </div>

    <!-- Engineering grid -->
    <div id="catalog-grid" class="grid sm:grid-cols-2 lg:grid-cols-4" style="border-top: 1px solid var(--c-border); border-left: 1px solid var(--c-border); background: var(--c-card);">

      {[
        { id:"EX-01", mark:"EX", name:"Экскаваторы",          cat:"earth",             specs:[["КОВШ","0.5–1.5 м³"],["ВЕС","до 22 т"],["РАБОТЫ","котлован"]], rate:"2 800 ₽/ч", shift:"22 000 ₽/смена", img:"/images/equipment/cat-excavator.jpg",      alt:"Аренда экскаватора в Москве",              hasImg:true  },
        { id:"MX-02", mark:"MX", name:"Мини-экскаваторы",     cat:"earth",             specs:[["ШИРИНА","от 1 м"],  ["ВЕС","до 5 т"],  ["ОБЪЕКТ","двор/участок"]], rate:"1 800 ₽/ч", shift:"14 000 ₽/смена", img:"/images/equipment/cat-mini-excavator.jpg",  alt:"Аренда мини-экскаватора в Москве",         hasImg:true  },
