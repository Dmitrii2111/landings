<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  // ── FAQ accordion ──
  (function() {
    var items = document.querySelectorAll('#faq .equipment-faq-item');
    if (!items.length) return;

    function openItem(item) {
      var trigger = item.querySelector('.equipment-faq-trigger');
      var panel = item.querySelector('.equipment-faq-panel');
      if (!trigger || !panel) return;
      item.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      panel.style.maxHeight = panel.scrollHeight + 'px';
    }

    function closeItem(item) {
      var trigger = item.querySelector('.equipment-faq-trigger');
      var panel = item.querySelector('.equipment-faq-panel');
      if (!trigger || !panel) return;
      item.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      panel.style.maxHeight = '0px';
    }

    items.forEach(function(item) {
      var trigger = item.querySelector('.equipment-faq-trigger');
      var panel = item.querySelector('.equipment-faq-panel');
      if (!trigger || !panel) return;

      // Initialize already-open item
      if (item.classList.contains('is-open')) {
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }

      trigger.addEventListener('click', function() {
        var isOpen = item.classList.contains('is-open');
        // Close all others (single-open accordion)
        items.forEach(function(other) {
          if (other !== item) closeItem(other);
        });
        if (isOpen) {
          closeItem(item);
        } else {
          openItem(item);
        }
      });
    });

    // Recalculate maxHeight on resize for open items
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        items.forEach(function(item) {
          if (item.classList.contains('is-open')) {
            var panel = item.querySelector('.equipment-faq-panel');
            if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
          }
        });
      }, 150);
    });
  })();

  // ── Catalog filters ──
  (function() {
    var filters = document.querySelectorAll('.catalog-filter');
    if (!filters.length) return;
    filters.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var f = btn.dataset.filter;
        filters.forEach(function(b) {
          var active = b === btn;
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
          if (active) {
            b.style.background = 'var(--c-ink)';
            b.style.color = '#fff';
            b.style.border = 'none';
          } else {
            b.style.background = 'var(--c-card)';
            b.style.color = 'var(--c-ink)';
            b.style.border = '1px solid var(--c-border)';
          }
        });
        var cards = document.querySelectorAll('#catalog-grid article');
        cards.forEach(function(card) {
          if (f === 'all') {
            card.style.display = '';
          } else {
            var cats = (card.dataset.category || '').split(' ');
            card.style.display = cats.indexOf(f) !== -1 ? '' : 'none';
          }
        });
      });
    });
  })();

  // ── Tariff row switching ──
  (function() {
    var rows = document.querySelectorAll('[data-tariff]');
    if (!rows.length) return;
    var tdFmt     = document.getElementById('td-fmt');
    var tdCond    = document.getElementById('td-cond');
    var tdRate    = document.getElementById('td-rate');
    var tdComment = document.getElementById('td-comment');

    function setInactive(row) {
      row.style.background = '';
      row.style.color = '';
      row.style.outline = '';
      row.style.outlineOffset = '';
      row.setAttribute('aria-selected', 'false');
      var cells = row.querySelectorAll('td');
      cells.forEach(function(td) { td.style.color = ''; });
    }

    function setActive(row) {
      row.style.background = 'var(--c-amber)';
      row.style.color = 'var(--c-dark)';
      row.style.outline = '';
      row.style.outlineOffset = '';
      row.setAttribute('aria-selected', 'true');
      var cells = row.querySelectorAll('td');
      cells.forEach(function(td) { td.style.color = 'var(--c-dark)'; });
      if (tdFmt)     tdFmt.textContent     = row.dataset.fmt     || '';
      if (tdCond)    tdCond.textContent    = row.dataset.cond    || '';
      if (tdRate)    tdRate.textContent    = row.dataset.rate    || '';
      if (tdComment) tdComment.textContent = row.dataset.comment || '';
    }

    rows.forEach(function(row) {
      row.addEventListener('click', function() {
        rows.forEach(setInactive);
        setActive(row);
      });
    });

    var def = document.querySelector('[data-tariff="shift8"]');
    if (def) {
      rows.forEach(setInactive);
      setActive(def);
    }
  })();
});
</script>

</body>
